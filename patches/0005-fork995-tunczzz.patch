+#define CS_RS "UAV(u0)"
+#define DRAW_RS "RootFlags(0)"
+RWByteAddressBuffer words : register(u0);
+[RootSignature(CS_RS)]
+[numthreads(64, 1, 1)]
+void work(uint3 id : SV_DispatchThreadID) {
+    uint was;
+    words.InterlockedAdd((id.x & 63) * 4, 1, was);
