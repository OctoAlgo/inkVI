# inkVI speed preset (= the --pr9b stack's speed.env, minus VICTORY_DYNAMIC_SLOTS; see docs/known-issues.md).
# One VAR=value per line; lines starting with # are skipped. Every switch defaults to off/unchanged when unset.
# Picture switches kept: VICTORY_AMBIENT* (stand-in for the missing ray-traced indirect light, tuned on the cell
# window), VICTORY_TEXTURE_BACK (water read-back: the boat no longer sinks), VICTORY_PIPELINE_WAIT_FIRST_MS (dark-cell
# fix: a pipeline's first draw waits up to 5 s instead of being dropped; inert with warm caches).
# Left out on purpose: VICTORY_VIEW_GUARD=0 and VICTORY_COMMIT_FLOOR_MB=6144 (lose the cell's left wall and window mesh),
# VICTORY_BACK_QUIET=1 (+0.0 % measured; its write-watch reset can erase a concurrent title store),
# VICTORY_DYNAMIC_SLOTS=524288 (+11 % measured, but see docs/known-issues.md).
VICTORY_DISPLAY_MODE=1920x1080
VICTORY_CHEAP_LOOKS=1
VICTORY_ASYNC_TEXTURES=4
VICTORY_ASYNC_TEXTURES_MB=256
VICTORY_STAGING_POOL_MB=128
VICTORY_HEAP_TEXTURE_MS=60
VICTORY_HEAP_ROLLING_RESCAN=1
VICTORY_LATE_WAIT=3
VICTORY_WIDE_BACK=1
VICTORY_JOIN_FETCH=1
VICTORY_CARD_BUFFERS_MIN_MB=1
VICTORY_DECLARE_ONCE=0
VICTORY_FINE_PAGES=1
VICTORY_HEAP_SLOT_CACHE=1
VICTORY_ASK_ONCE_VIEWS=1
VICTORY_WIDE_COPY=1
VICTORY_WIDE_MERGE=1
VICTORY_WIDE_FILLS=1
VICTORY_CARD_NO_PC_COPY=0
VICTORY_WAVE_WIDE=0
VICTORY_HEAP_RECHECK=0
VICTORY_REUPLOAD_WHEN_FULL=0
VICTORY_HEAP_SYNC_TABLES=2
VICTORY_TABLE_INDEXED=1
VICTORY_GPU_UPLOAD_COPIES=1
VICTORY_GPU_UPLOAD_COPIES_MB=4096
VICTORY_TABLE_ON_CARD=1
VICTORY_INDIRECT_BATCH=3
VICTORY_GUARD_PLACEHOLDERS=1
VICTORY_AHEAD_INDEX=1
VICTORY_VIEWS_TRIM=1
VICTORY_VIEW_KNOWN=1
VICTORY_DECLARED_WIDE=1
VICTORY_WIDE_TEXTURES=1
VICTORY_STALE_ONCE=1
VICTORY_CARD_FETCH_INFLIGHT=2
VICTORY_SYNC_NULL_SKIP=1
VICTORY_PIPELINE_WAIT_MS=0
VICTORY_AMBIENT=0.3
VICTORY_AMBIENT_TINT=1,0.6,0.4
VICTORY_AMBIENT_SHADE=1.5,0.8,0.1,0.45
VICTORY_COPY_PLAIN=1
VICTORY_JOIN_PARTS=1
VICTORY_BACK_OWN_VIEW=1
VICTORY_GPU_UPLOAD=1
VICTORY_CARD_REHASH_RUNS=1
VICTORY_TEXTURE_BACK=1
VICTORY_MADE_STRIPES=1024
VICTORY_SYNC_WIDE=8
VICTORY_CARD_HASH_WIDE=1
VICTORY_TABLE_STAGES=1
VICTORY_CARD_BUFFERS_MB=1536
VICTORY_CARD_BUFFERS_MIN_KB=64
VICTORY_PIPELINE_WAIT_FIRST_MS=5000
# Off by default (patch 0038): game time at real speed below 15 fps (the title's step ceiling 1/15 s -> 0.2 s, i.e.
# real time down to 5 fps). UNTESTED under driving/combat (vehicles at speed, ragdolls, collisions): see
# docs/known-issues.md before you turn it on.
#VICTORY_DT_MAX=0.2
