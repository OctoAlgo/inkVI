+                &Step::Fill(_, src, len, _) | &Step::CardFill(_, src, len) => (src, len),
+                _ => continue,
+            };
+            if !written.is_empty() && written.iter().any(|&(a, e)| a < src + len && e > src) {
+                later += 1;
+            }
+        }
+        for &(d, _, n) in &deferred.gpu_copied {
+            any = true;
+            written.push((d, d + n));
+        }
+    }
+    if any {
+        c::add(c::LATER_READS, later);
+        c::add(c::CPU_BESIDE, beside);
