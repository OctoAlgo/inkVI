+/// `VICTORY_PIPELINE_PRIORITY=normal`: the workers run at the title's
+/// priority instead of below it (round 9b: the dark-cell runs' early
+/// pipelines were made minutes late, while the title was loading).
+fn normal_priority() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("VICTORY_PIPELINE_PRIORITY").is_ok_and(|v| v == "normal"))
+}
+
+/// Per worker: what it does (0 waiting for work, 1 making, 2 saving) in
+/// the top byte, since when (`crate::host::now_ms`) below; its thread id.
+static STATE: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+static TID: [AtomicU64; 8] = [const { AtomicU64::new(0) }; 8];
+
+fn mark(slot: usize, what: u64) {
+    STATE[slot].store(what << 56 | (crate::host::now_ms() & ((1 << 56) - 1)), Ordering::Relaxed);
+}
+
+/// Every 2 s while pipelines are queued (`VICTORY_PIPELINE_WATCH=0`: never;
+/// at most 300 lines): the queue, the counts and what each worker does and
+/// for how long, with the library calls running (round 9b dark-cell hunt).
+fn watch() {
+    if std::env::var("VICTORY_PIPELINE_WATCH").is_ok_and(|v| v == "0") {
+        return;
+    }
+    let _ = std::thread::Builder::new().name("victory-pipelines-watch".into()).spawn(|| {
+        use super::library::{EARLY, LOADED, MADE};
+        let mut lines = 0;
+        while lines < 300 {
+            std::thread::sleep(Duration::from_secs(2));
+            let waiting = WAITING.load(Ordering::Relaxed);
+            if waiting == 0 {
+                continue;
+            }
+            lines += 1;
+            let (early, requested) = {
+                let q = QUEUE.lock().unwrap_or_else(|e| e.into_inner());
+                (q.early.len(), q.requested.len())
+            };
+            let now = crate::host::now_ms();
+            let workers: Vec<String> = STATE
+                .iter()
+                .zip(&TID)
+                .filter(|(_, t)| t.load(Ordering::Relaxed) != 0)
+                .map(|(s, t)| {
+                    let s = s.load(Ordering::Relaxed);
+                    let what = ["idle", "making", "saving"].get((s >> 56) as usize).copied().unwrap_or("?");
+                    format!("{}:{what}:{}ms", t.load(Ordering::Relaxed), now.saturating_sub(s & ((1 << 56) - 1)))
+                })
+                .collect();
+            tracing::info!(
+                waiting,
+                early,
+                requested,
+                made = MADE.load(Ordering::Relaxed),
+                loaded = LOADED.load(Ordering::Relaxed),
+                started_early = EARLY.load(Ordering::Relaxed),
+                workers = %workers.join(" "),
+                calls = %super::library::calls_now(),
+                "pipeline workers"
+            );
+        }
+    });
+}
+
 /// The most pipelines waiting at once since the workers last ran out.
 static PEAK: AtomicU64 = AtomicU64::new(0);
 
