diff --git a/crates/victory-shader/src/emit/split.rs b/crates/victory-shader/src/emit/split.rs
new file mode 100644
index 000000000..9564f9e1a
--- /dev/null
+++ b/crates/victory-shader/src/emit/split.rs
@@ -0,0 +1,277 @@
+//! A console wave of 64 lanes as two host waves of 32 that never meet, where that is exact:
+//! the cheaper forms tried before the forms that exchange the halves' values through group
+//! barriers ([`super::forms::EXCHANGE`]) or run both halves in one host wave
+//! ([`super::forms::PAIRED`]).
+
+use std::collections::{HashMap, HashSet};
+
+use super::{HostShader, emit_program, forms, idiom, lower};
+use crate::dxbc::Container;
+use crate::gfx10::{Fields, Operand};
+use crate::ir::{Inst, Program, Reg, Value};
+use crate::native::NativeProgram;
+use crate::structure::{Bool, Meets, Structured};
+use crate::{ShaderError, io, resource, structure};
+
+type Emitted = Result<(HostShader, Option<u32>), ShaderError>;
+
+/// How a VGPR value is read.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Use {
+    /// As its own lane's source.
+    Source,
+    /// Only as the old value of the register an instruction overwrites under its guard: the
+    /// lanes outside the guard keep it.
+    Keep,
+    /// As a source and as the old value of the register an instruction writes (an
+    /// accumulator, a write of part of the register, the register among its sources).
+    Both,
+    /// At a join, from an earlier block (not around a loop): the join's value.
+    Join(Value),
+    /// By the first lane that runs the reader under its guard (`v_readfirstlane_b32`). A host
+    /// wave with no lane of the guard reads a lane outside it, where the console reads the
+    /// other half's first lane: the idiom's first-lane reads, whose results only the lanes of
+    /// the guard act on in the allocation it proves ([`idiom::wave_local`]'s shortcut).
+    First,
+    /// By a whole-wave section's select of the lanes that ran (or did not run) before it, in
+    /// the lanes where the mask is (is not) set, whatever their guard.
+    Masked(Bool, bool),
+    /// From other lanes (DPP, a lane read or write, a swizzle, a permute, a whole-wave
+    /// section's other steps), or at a loop's join.
+    Other,
+}
+
+/// Whether `inst` overwrites the whole of register `r` in each lane of its guard without
+/// reading it: a plain vector operation whose sources do not name `r`.
+fn overwrites(inst: &Inst, r: u8) -> bool {
+    let Fields::Valu(v) = &inst.fields else { return false };
+    let name = inst.name();
+    let names = |op: &Operand| matches!(*op, Operand::Vector { reg, dwords } if reg <= r && r < reg + dwords.max(1));
+    v.dpp.is_none()
+        && v.sdwa.is_none()
+        && v.opsel & 8 == 0
+        && !name.contains("16")
+        && !name.contains("mac")
+        && !name.contains("mix")
+        && !name.contains("dot")
+        && !name.contains("lane")
+        && !name.starts_with("v_movrel")
+        && !name.starts_with("v_swap")
+        && !v.src.iter().any(names)
+}
+
+/// Steps [`read_inside_only`] takes from one write before it gives up (and takes the write's
+/// old lanes as read).
+const MAX_STEPS: usize = 4096;
+
+/// The VGPR values written under a guard whose old lanes no lane reads: where the lanes outside
+/// the guard keep what the register held (a wave-wide count, say), no reader takes it there.
+/// For [`idiom::wave_local`], which otherwise takes such a write as mixing that old value in.
+///
+/// A guarded write holds the old value in the lanes outside its guard and outside the guards
+/// of the writes it overwrote in a row: a chain of guards, which a write of the whole register
+/// in each lane of its guard adds its guard to, and a write of part of it (or one that also
+/// reads it) keeps as it is. Followed from the write: a reader that reads it as its own
+/// lane's source, under a guard that some lane entering the reader's block meets outside
+/// every guard of the chain, reads the old lanes; so does a reader of other lanes and a loop's
+/// join. A later guarded write that keeps it, and a join from an earlier block, carry it on
+/// with the chain as it stands there.
+///
+/// A reader reads the writer's SSA value (or a join's that took it), so the writer dominates
+/// it, and the lane-mask atoms of the guards have the same values at both (`guarded`'s
+/// argument for the paired form): the guards as functions
+/// ([`crate::structure::Bools::meet`]) say what holds lane by lane.
+pub(super) fn read_inside_only(p: &Program, st: &Structured) -> HashSet<Value> {
+    let order = crate::ir::reverse_postorder(&p.blocks);
+    let mut rpo = vec![usize::MAX; p.blocks.len()];
+    for (n, &b) in order.iter().enumerate() {
+        rpo[b] = n;
+    }
+    // readers of each value: (block, instruction or none for a join, how, what the reader
+    // writes to the same register)
+    let mut uses: HashMap<Value, Vec<(usize, Option<usize>, Use, Option<Value>)>> = HashMap::new();
+    for (b, block) in p.blocks.iter().enumerate() {
+        for phi in &block.phis {
+            for (&a, &q) in phi.args.iter().zip(&block.preds) {
+                let how = if rpo[q] < rpo[b] { Use::Join(phi.value) } else { Use::Other };
+                uses.entry(a).or_default().push((b, None, how, None));
+            }
+        }
+        let sections = super::wave::sections(p, b);
+        for (i, inst) in block.insts.iter().enumerate() {
+            let name = inst.name();
+            let section = sections.iter().any(|(&s, sec)| s < i && i < sec.end);
+            let other_lanes = match &inst.fields {
+                Fields::Valu(v) => v.dpp.is_some() || name.contains("lane") && name != "v_readfirstlane_b32",
+                Fields::Ds { .. } => name.starts_with("ds_swizzle") || name.contains("permute"),
+                _ => false,
+            } || section;
+            // a section's select of the lanes that ran before it (`v_cndmask_b32 d, a, b, m`:
+            // b where m is set, a elsewhere)
+            let picked = match &inst.fields {
+                Fields::Valu(v) if section && name == "v_cndmask_b32" && v.dpp.is_none() && v.sdwa.is_none() => {
+                    match v.src.get(2) {
+                        Some(&Operand::Scalar { code, .. }) => {
+                            inst.read(Reg::S(code)).and_then(|m| st.masks.get(&m).copied()).map(|m| (m, v.src.clone()))
+                        }
+                        _ => None,
+                    }
+                }
+                _ => None,
+            };
+            for &(r, v) in &inst.reads {
+                let again = inst.writes.iter().find(|w| w.0 == r).map(|w| w.1);
+                let from = |k: usize| matches!(picked.as_ref().and_then(|(_, src)| src.get(k)), Some(&Operand::Vector { reg, .. }) if Reg::V(reg) == r);
+                let how = match (r, again) {
+                    _ if picked.is_some() && from(1) && !from(0) => Use::Masked(picked.as_ref().expect("picked").0, true),
+                    _ if picked.is_some() && from(0) && !from(1) => Use::Masked(picked.as_ref().expect("picked").0, false),
+                    _ if other_lanes => Use::Other,
+                    _ if name == "v_readfirstlane_b32" => Use::First,
+                    (Reg::V(n), Some(_)) if overwrites(inst, n) => Use::Keep,
+                    (Reg::V(_), Some(_)) => Use::Both,
+                    _ => Use::Source,
+                };
+                uses.entry(v).or_default().push((b, Some(i), how, again));
+            }
+        }
+    }
+    // each guarded write's chain of guards, in program order
+    let mut chain: HashMap<Value, Vec<Bool>> = HashMap::new();
+    let mut writes = Vec::new();
+    for &b in &order {
+        for (i, inst) in p.blocks[b].insts.iter().enumerate() {
+            let Some(g) = st.guards[b][i] else { continue };
+            for &(r, w) in &inst.writes {
+                let Reg::V(n) = r else { continue };
+                let old = inst.read(r).and_then(|o| chain.get(&o)).cloned().unwrap_or_default();
+                chain.insert(w, if overwrites(inst, n) { [vec![g], old].concat() } else { old });
+                writes.push(w);
+            }
+        }
+    }
+    let mut meets = Meets::default();
+    let mut out = HashSet::new();
+    for w in writes {
+        // (value, chain) still to follow
+        let mut work = vec![(w, chain[&w].clone())];
+        let (mut steps, mut shows) = (0, false);
+        'follow: while let Some((v, c)) = work.pop() {
+            for &(rb, ri, how, again) in uses.get(&v).into_iter().flatten() {
+                steps += 1;
+                if steps > MAX_STEPS {
+                    shows = true;
+                    break 'follow;
+                }
+                let guard = ri.and_then(|i| st.guards[rb][i]);
+                // some lane entering the reader's block meets `cond` outside every guard of
+                // the chain
+                let mut outside = |cond: Option<(Bool, bool)>| {
+                    if let Some((g, true)) = cond
+                        && c.contains(&g)
+                    {
+                        return false;
+                    }
+                    let mut all = vec![(st.reach[rb], true)];
+                    all.extend(cond);
+                    all.extend(c.iter().map(|&g| (g, false)));
+                    st.bools.meet_seen(&all, &mut meets)
+                };
+                let own = guard.map(|g| (g, true));
+                // (an unguarded write overwrites every lane that runs it)
+                let carried = |c: Vec<Bool>| match (again, guard) {
+                    (Some(w2), Some(_)) => Some((w2, c)),
+                    _ => None,
+                };
+                match how {
+                    Use::Other => shows = true,
+                    Use::Source => shows = outside(own),
+                    Use::First => shows = outside(own),
+                    Use::Masked(m, set) => shows = outside(Some((m, set))),
+                    Use::Keep => work.extend(carried([vec![guard.unwrap_or(Bool::TRUE)], c.clone()].concat())),
+                    Use::Both => {
+                        shows = outside(own);
+                        work.extend(carried(c.clone()));
+                    }
+                    Use::Join(j) => work.push((j, c.clone())),
+                }
+                if shows {
+                    break 'follow;
+                }
+            }
+        }
+        if !shows {
+            out.insert(w);
+        }
+    }
+    out
+}
+
+/// Whether these forms are tried (`VICTORY_WAVE_SPLIT=0`: no, the forms as before).
+pub(super) fn on() -> bool {
+    std::env::var_os("VICTORY_WAVE_SPLIT").is_none_or(|v| v != "0")
+}
+
+/// `r`, the program `p` in the exchange form (two host waves of 32 for each console wave, which
+/// exchange first lanes, masks, sums and lane reads through LDS between two group barriers), or
+/// instead each host wave on its own ([`lower::with_local_waves`]) where every wave-wide value
+/// of `p` is used as the allocation idiom uses it ([`idiom::wave_local`]): the same values for
+/// every lane, the slots a wave reserves in another order, and none of the barriers (each
+/// exchange is two: a group of 64 threads stood at four a lane read).
+///
+/// The title's `CS_Primary_RegisterAllocationRequests`, a reservation by each wave's first lane
+/// of its count of requests (a whole-wave sum of what only that lane holds, then each lane at
+/// the base plus its rank), took 3.7 ms of the card per dispatch in the opening cutscene in
+/// the exchange form, which was tried first: the idiom form was only tried for programs no
+/// form in two host waves took.
+///
+/// Diagnostics: `VICTORY_WAVE_PAIRED_OVER_EXCHANGE=1` gives the remaining exchange-form programs
+/// the paired form where it translates them, to time one against the other in a run.
+pub(super) fn local_if_exact(
+    c: &Container,
+    native: &NativeProgram,
+    p: &Program,
+    st: &structure::Structured,
+    io: &io::Io,
+    res: &resource::Resources,
+    r: Emitted,
+) -> Emitted {
+    let exchange = matches!(&r, Ok((shader, Some(32))) if forms::form_of(&shader.dxil) == forms::EXCHANGE);
+    if !exchange || !on() {
+        return r;
+    }
+    let why = std::env::var_os("VICTORY_WAVE_WHY").is_some();
+    let idiom = idiom::wave_local(p, st);
+    if let (Err((offset, what)), true) = (&idiom, why) {
+        eprintln!("WAVE64-SPLIT the exchange kept: not the allocation idiom at {offset:#x}: {what}");
+    }
+    if idiom.is_ok() {
+        let local = lower::with_local_waves(|| emit_program(c, native, p, st, io, res));
+        if why {
+            match &local {
+                Ok((_, wave)) => eprintln!("WAVE64-SPLIT local waves (idiom) instead of the exchange: wave {wave:?}"),
+                Err(e) => eprintln!("WAVE64-SPLIT local waves (idiom) instead of the exchange: {e}"),
+            }
+        }
+        if let Ok((shader, Some(32))) = local
+            && forms::form_of(&shader.dxil) == forms::LOCAL
+        {
+            return Ok((shader, Some(32)));
+        }
+    }
+    if cfg!(feature = "diagnostics")
+        && std::env::var_os("VICTORY_WAVE_PAIRED_OVER_EXCHANGE").is_some_and(|v| v == "1")
+        && super::pairs_on()
+    {
+        let paired = super::paired(c, native, p, io, res);
+        if why {
+            match &paired {
+                Ok((_, wave)) => eprintln!("WAVE64-SPLIT paired lanes instead of the exchange: wave {wave:?}"),
+                Err(e) => eprintln!("WAVE64-SPLIT paired lanes instead of the exchange: {e}"),
+            }
+        }
+        if paired.is_ok() {
+            return paired;
+        }
+    }
+    r
+}
diff --git a/crates/victory-shader/src/emit/trip.rs b/crates/victory-shader/src/emit/trip.rs
new file mode 100644
index 000000000..6d82db5d4
--- /dev/null
+++ b/crates/victory-shader/src/emit/trip.rs
@@ -0,0 +1,440 @@
+//! Loops whose number of passes the code fixes: a scalar counter that
+//! starts at a constant, moves by a constant step each pass and is compared
+//! with a constant where the loop decides to go round again. The console
+//! runs such a loop to its end whatever the data, and so must the host: the
+//! iteration limit of translated loops (`lower::PIXEL_LOOP_LIMIT`) is for loops
+//! whose end the data decides.
+
+use std::collections::{HashMap, HashSet};
+
+use crate::gfx10::{Fields, Operand};
+use crate::ir::{Exit, Program, Reg, Value};
+
+/// Passes past which a counted loop is left to the stage's limit: more is
+/// no loop a frame of the title runs per lane.
+const MOST: u32 = 1 << 16;
+
+/// How a counter value is made.
+enum Def<'a> {
+    /// A join: block and phi index.
+    Phi(usize, usize),
+    /// An instruction.
+    Inst(&'a crate::ir::Inst),
+}
+
+/// The number of times loop `header` (a block with a back edge into it,
+/// `rpo` its blocks' reverse-postorder numbers) goes round again, when its
+/// code fixes it ([`self`]) at [`MOST`] or fewer; None otherwise. With one
+/// back edge, from a latch whose branch on SCC either goes back or leaves
+/// the loop, or from a latch that always goes back to a header whose
+/// branch on SCC stays in the loop or leaves it.
+pub(super) fn constant_passes(p: &Program, rpo: &[usize], header: usize) -> Option<u32> {
+    let latches: Vec<usize> = p.blocks[header]
+        .preds
+        .iter()
+        .copied()
+        .filter(|&q| rpo[q] != usize::MAX && rpo[header] <= rpo[q])
+        .collect();
+    let [latch] = latches[..] else {
+        return None;
+    };
+    let body = body(p, header, latch);
+    // The block that decides, and which way of its branch stays in the loop.
+    let (test, stay) = match p.blocks[latch].exit {
+        Exit::Branch { taken, not_taken } if taken == header && !body.contains(&not_taken) => {
+            (latch, true)
+        }
+        Exit::Branch { taken, not_taken } if not_taken == header && !body.contains(&taken) => {
+            (latch, false)
+        }
+        Exit::Jump(_) => match p.blocks[header].exit {
+            Exit::Branch { taken, not_taken }
+                if body.contains(&taken) && !body.contains(&not_taken) =>
+            {
+                (header, true)
+            }
+            Exit::Branch { taken, not_taken }
+                if body.contains(&not_taken) && !body.contains(&taken) =>
+            {
+                (header, false)
+            }
+            _ => return None,
+        },
+        _ => return None,
+    };
+    let defs = definitions(p);
+    // The branch: on SCC, set (`s_cbranch_scc1`) or clear.
+    let branch = p.blocks[test].insts.last()?;
+    let set = match branch.name() {
+        "s_cbranch_scc1" => true,
+        "s_cbranch_scc0" => false,
+        _ => return None,
+    };
+    let scc = branch.read(Reg::Scc)?;
+    let Some(Def::Inst(cmp)) = defs.get(&scc) else {
+        return None;
+    };
+    let (op, a, b) = compare(cmp)?;
+    // One side a counter of the header's, the other a constant.
+    let (counter, k, swapped) = match (a, b) {
+        (Side::Value(v), Side::Const(k)) => (v, k, false),
+        (Side::Const(k), Side::Value(v)) => (v, k, true),
+        _ => return None,
+    };
+    let (phi, offset) = trace(p, &defs, counter)?;
+    let Some(&Def::Phi(pb, pi)) = defs.get(&phi) else {
+        return None;
+    };
+    if pb != header {
+        return None;
+    }
+    // Its start from outside the loop, its step from the latch.
+    let join = &p.blocks[header].phis[pi];
+    let (mut start, mut step) = (None, None);
+    for (&q, &arg) in p.blocks[header].preds.iter().zip(&join.args) {
+        if rpo[q] == usize::MAX {
+            continue;
+        }
+        if q == latch {
+            let (from, by) = trace(p, &defs, arg)?;
+            (from == phi).then_some(())?;
+            step = Some(by);
+        } else {
+            let c = constant(&defs, arg)?;
+            if start.is_some_and(|s| s != c) {
+                return None;
+            }
+            start = Some(c);
+        }
+    }
+    let (start, step) = (start?, step?);
+    if step == 0 {
+        return None;
+    }
+    // Pass n compares start + n step + offset; the loop goes round again
+    // while the branch takes its staying side.
+    let mut x = start.wrapping_add(offset);
+    for n in 0..=MOST {
+        let holds = if swapped {
+            op.holds(k, x)
+        } else {
+            op.holds(x, k)
+        };
+        // The branch is taken when SCC is what it tests for.
+        let taken = holds == set;
+        if taken != stay {
+            return Some(n);
+        }
+        x = x.wrapping_add(step);
+    }
+    None
+}
+
+/// The blocks of the loop of `header` closed by `latch`: those that reach the
+/// latch without passing the header.
+fn body(p: &Program, header: usize, latch: usize) -> HashSet<usize> {
+    let mut body = HashSet::from([header, latch]);
+    let mut work = vec![latch];
+    while let Some(b) = work.pop() {
+        if b == header {
+            continue;
+        }
+        for &q in &p.blocks[b].preds {
+            if body.insert(q) {
+                work.push(q);
+            }
+        }
+    }
+    body
+}
+
+/// Where each value is made.
+fn definitions(p: &Program) -> HashMap<Value, Def<'_>> {
+    let mut defs = HashMap::new();
+    for (b, block) in p.blocks.iter().enumerate() {
+        for (i, phi) in block.phis.iter().enumerate() {
+            defs.insert(phi.value, Def::Phi(b, i));
+        }
+        for inst in &block.insts {
+            for &(_, v) in &inst.writes {
+                defs.insert(v, Def::Inst(inst));
+            }
+        }
+    }
+    defs
+}
+
+/// A compare's operand: a scalar value, or a constant.
+enum Side {
+    Value(Value),
+    Const(u32),
+}
+
+#[derive(Clone, Copy)]
+enum Op {
+    Eq,
+    Ne,
+    Gt(bool),
+    Ge(bool),
+    Lt(bool),
+    Le(bool),
+}
+
+impl Op {
+    /// `a op b` (the flag: signed).
+    fn holds(self, a: u32, b: u32) -> bool {
+        let ord = |signed: bool| {
+            if signed {
+                (a as i32).cmp(&(b as i32))
+            } else {
+                a.cmp(&b)
+            }
+        };
+        match self {
+            Op::Eq => a == b,
+            Op::Ne => a != b,
+            Op::Gt(s) => ord(s).is_gt(),
+            Op::Ge(s) => ord(s).is_ge(),
+            Op::Lt(s) => ord(s).is_lt(),
+            Op::Le(s) => ord(s).is_le(),
+        }
+    }
+}
+
+/// A 32-bit scalar compare (`s_cmp_*`, `s_cmpk_*`): its test and operands.
+fn compare(inst: &crate::ir::Inst) -> Option<(Op, Side, Side)> {
+    let name = inst.name();
+    let (rest, k) = match (name.strip_prefix("s_cmpk_"), name.strip_prefix("s_cmp_")) {
+        (Some(rest), _) => (rest, true),
+        (None, Some(rest)) => (rest, false),
+        _ => return None,
+    };
+    let (test, ty) = rest.split_once('_')?;
+    let signed = match ty {
+        "i32" => true,
+        "u32" => false,
+        _ => return None,
+    };
+    let op = match test {
+        "eq" => Op::Eq,
+        "lg" => Op::Ne,
+        "gt" => Op::Gt(signed),
+        "ge" => Op::Ge(signed),
+        "lt" => Op::Lt(signed),
+        "le" => Op::Le(signed),
+        _ => return None,
+    };
+    let Fields::Sop { src, imm, .. } = &inst.fields else {
+        return None;
+    };
+    let side = |op: &Operand| match *op {
+        Operand::Scalar { code, dwords: 1 } => inst.read(Reg::S(code)).map(Side::Value),
+        Operand::Const(c) => crate::resource::inline(c).map(Side::Const),
+        Operand::Literal(l) => Some(Side::Const(l)),
+        _ => None,
+    };
+    if k {
+        // SOPK: the register against the 16-bit immediate, sign-extended
+        // for the signed tests.
+        let imm = (*imm)?;
+        let b = if signed {
+            imm as i16 as i32 as u32
+        } else {
+            u32::from(imm)
+        };
+        Some((op, side(src.first()?)?, Side::Const(b)))
+    } else {
+        Some((op, side(src.first()?)?, side(src.get(1)?)?))
+    }
+}
+
+/// The constant `v` holds, through moves and joins of one value.
+fn constant(defs: &HashMap<Value, Def<'_>>, v: Value) -> Option<u32> {
+    let mut v = v;
+    for _ in 0..64 {
+        match defs.get(&v)? {
+            Def::Inst(inst) if inst.name() == "s_mov_b32" => {
+                let Fields::Sop { src, .. } = &inst.fields else {
+                    return None;
+                };
+                match *src.first()? {
+                    Operand::Const(c) => return crate::resource::inline(c),
+                    Operand::Literal(l) => return Some(l),
+                    Operand::Scalar { code, dwords: 1 } => v = inst.read(Reg::S(code))?,
+                    _ => return None,
+                }
+            }
+            Def::Inst(inst) if inst.name() == "s_movk_i32" => {
+                let Fields::Sop { imm, .. } = &inst.fields else {
+                    return None;
+                };
+                return Some((*imm)? as i16 as i32 as u32);
+            }
+            _ => return None,
+        }
+    }
+    None
+}
+
+/// `v` as a header's counter plus a constant: the value it started from
+/// (a join that is not one of a single value) and what moves, adds and
+/// subtractions of constants added to it.
+fn trace(p: &Program, defs: &HashMap<Value, Def<'_>>, v: Value) -> Option<(Value, u32)> {
+    let (mut v, mut sum) = (v, 0u32);
+    for _ in 0..256 {
+        match defs.get(&v)? {
+            Def::Phi(b, i) => {
+                // A join of one value (and of itself) is that value.
+                let mut others = p.blocks[*b].phis[*i]
+                    .args
+                    .iter()
+                    .copied()
+                    .filter(|&a| a != v);
+                match others.next() {
+                    Some(one) if others.all(|a| a == one) => v = one,
+                    _ => return Some((v, sum)),
+                }
+            }
+            Def::Inst(inst) => {
+                let Fields::Sop { src, imm, .. } = &inst.fields else {
+                    return None;
+                };
+                let reg = |op: &Operand| match *op {
+                    Operand::Scalar { code, dwords: 1 } => inst.read(Reg::S(code)),
+                    _ => None,
+                };
+                let konst = |op: &Operand| match *op {
+                    Operand::Const(c) => crate::resource::inline(c),
+                    Operand::Literal(l) => Some(l),
+                    _ => None,
+                };
+                match inst.name() {
+                    "s_mov_b32" => v = reg(src.first()?)?,
+                    "s_addk_i32" => {
+                        // SOPK: the destination is the source.
+                        let dst = inst.writes.iter().find(|w| matches!(w.0, Reg::S(_)))?.0;
+                        v = inst.read(dst)?;
+                        sum = sum.wrapping_add((*imm)? as i16 as i32 as u32);
+                    }
+                    name @ ("s_add_u32" | "s_add_i32" | "s_sub_u32" | "s_sub_i32") => {
+                        let (a, b) = (src.first()?, src.get(1)?);
+                        let sub = name.starts_with("s_sub");
+                        let (from, k) = match (reg(a), konst(b), konst(a), reg(b)) {
+                            (Some(x), Some(k), _, _) => (x, k),
+                            // (`k - x` is no step of `x`.)
+                            (_, _, Some(k), Some(x)) if !sub => (x, k),
+                            _ => return None,
+                        };
+                        v = from;
+                        sum = if sub {
+                            sum.wrapping_sub(k)
+                        } else {
+                            sum.wrapping_add(k)
+                        };
+                    }
+                    _ => return None,
+                }
+            }
+        }
+    }
+    None
+}
