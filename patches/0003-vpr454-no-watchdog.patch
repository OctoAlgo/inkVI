diff --git a/crates/victory-loader/src/windows.rs b/crates/victory-loader/src/windows.rs
index e709d115a..678026428 100644
--- a/crates/victory-loader/src/windows.rs
+++ b/crates/victory-loader/src/windows.rs
@@ -84,6 +84,14 @@ pub fn load(prepared: &PreparedImage, dir: &Path) -> Result<LoadedImage> {
         // SAFETY: just mapped, and no title code has run.
         unsafe { crate::tls::redirect(loaded.base(), &loaded.info) }?;
     }
+    // LOCAL (octo), from the testers build: `VICTORY_NO_WATCHDOG` disarms the title's watchdog
+    // thread, which ends the process on purpose (a write to address 0) when the main thread has
+    // not advanced for about 30 s, as the slow first world frames do.
+    if std::env::var_os(crate::hooks::NO_WATCHDOG_ENV).is_some() {
+        // SAFETY: just mapped, and no title code has run.
+        let applied = unsafe { crate::hooks::disarm_watchdog(loaded.base(), &prepared.original_hash) };
+        tracing::info!(applied, "title watchdog hooks ({})", crate::hooks::NO_WATCHDOG_ENV);
+    }
     tracing::info!(
         base = format_args!("{:#x}", loaded.base()),
         preferred = format_args!("{:#x}", loaded.info.image_base),
