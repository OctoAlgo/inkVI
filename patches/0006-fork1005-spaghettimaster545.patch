From: SpaghettiMaster545
 <74583115+SpaghettiMaster545@users.noreply.github.com>
Date: Tue, 24 Nov 2026 20:25:14 +0100
Subject: [PATCH 06/37] xmem: tell the GPU side of an unmapped view after
 unmapping it

unmap() told victory_gpu that a view's memory changed before it unmapped
the view. A GPU copy refreshing the range in between could guard the
still-mapped blocks and note them clean; once unmapped they stayed clean,
so copies kept the view's old bytes until something was mapped there
again. Telling after the unmap clears that state, and the next refresh
takes the memory as it now is (its blocks known unmapped, their zeros
copied once).

(cherry picked from commit 97a5900d)
(cherry picked from commit 6f11f27c74b4ac7a486ad1303248593530359471)

Kit-Source: victory-fork PR #1005 (SpaghettiMaster545)
Kit-Licence: GPL-3.0
---
 crates/victory-hle/src/modules/xmem.rs | 18 +++---------------
 1 file changed, 3 insertions(+), 15 deletions(-)

diff --git a/crates/victory-hle/src/modules/xmem.rs b/crates/victory-hle/src/modules/xmem.rs
index 4c1041736..2f3b1d1b8 100644
--- a/crates/victory-hle/src/modules/xmem.rs
+++ b/crates/victory-hle/src/modules/xmem.rs
@@ -1170,12 +1170,6 @@ fn unmap(physical: &mut Physical, base: usize, len: usize) {
                 }
             }
         }
-        use victory_gpu::framelog::{T, add};
-        let started = std::time::Instant::now();
-        victory_gpu::title_memory_remapped(at, size);
-        let noted = std::time::Instant::now();
-        add(T::RemapNotesUs, (noted - started).as_micros() as u64);
-        let meter = Meter::begin();
         // SAFETY: a view we mapped; it becomes a placeholder again.
         unsafe {
             UnmapViewOfFile2(
@@ -1186,15 +1180,9 @@ fn unmap(physical: &mut Physical, base: usize, len: usize) {
                 MEM_PRESERVE_PLACEHOLDER,
             )
         };
-        meter.end(false);
-        add(T::RemapUnmapUs, noted.elapsed().as_micros() as u64);
-        // What of the view lies outside the range asked for is mapped
-        // again below: the whole view went for it.
-        let outside = base.saturating_sub(at) + (at + size).saturating_sub(end);
-        if outside != 0 {
-            add(T::RemapCuts, 1);
-            add(T::RemapCutBytes, outside as u64);
-        }
+        // Told once the view is gone: a GPU copy that guarded it in between
+        // would otherwise keep it clean, and its old bytes, from then on.
+        victory_gpu::title_memory_remapped(at, size);
         if at < base {
             map(physical, at, base - at, slice.clone());
         }
