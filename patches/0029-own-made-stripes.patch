+//! The record each slot of a host descriptor heap was made from
+//! (`HostHeap::made`): one key per slot, read without a lock and changed
+//! under one of a few striped locks (`VICTORY_MADE_STRIPES`).
+//!
+//! With one stripe (the default) every slot is behind the same lock, as
+//! the `Mutex<Vec<u64>>` it replaces: the heap sync on the submitting
+//! thread, the pass over buffer views on a recording thread and the
+//! title's view calls then all wait for each other, slot by slot (some
+//! 80,000 takes a frame; the sync of a frame waited 9 to 33 ms for the
+//! others and spent its own 45 ms serially, 2026-11-25, runs r4e/r5b).
+//! With `VICTORY_MADE_STRIPES=1024` a slot's lock is the one of its index
+//! modulo 1024: slots mirrored at once on different threads nearly never
+//! share one, and a slot whose key is already the record's is answered
+//! from the atomic alone (`Made::get`).
+//!
+//! The rules that keep a slot right:
+//! - a slot's key and its host descriptor change only while its stripe is
+//!   held ([`Slot`]); making a slot writes the descriptor first, then the
+//!   key, and unmaking takes the key first, then writes the null: a
+//!   reader without the lock never takes a null for a made slot (it may
+//!   take a made slot for one to make, which costs the lock and nothing
+//!   else);
+//! - a reader without the lock ([`Made::get`]) sees either the key from
+//!   before such a change or the one after, each with the descriptor it
+//!   went with (release/acquire);
+//! - a slot of another stripe is never touched while a stripe is held:
+//!   the caller releases its stripe first and comes back with
+//!   [`Made::change_if`], which does nothing if the slot changed meanwhile
+//!   (two threads taking two stripes in opposite orders would otherwise
+//!   wait for each other for ever).
+//!
+//! No Windows types here, so the tests run natively.
+
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Mutex, MutexGuard};
+
+/// The keys of a heap's slots and their striped locks.
+pub(crate) struct Made {
+    keys: Box<[AtomicU64]>,
+    /// A power of two of them.
+    stripes: Box<[Mutex<()>]>,
+}
+
+/// Slot `index` held: its stripe is locked until this is dropped.
+pub(crate) struct Slot<'a> {
+    made: &'a Made,
+    index: usize,
+    _stripe: MutexGuard<'a, ()>,
+}
+
+/// `VICTORY_MADE_STRIPES`: how many locks the slots of a host heap share
+/// (rounded up to a power of two, at most 65,536). 1 (the default): one
+/// lock for all, as before.
+pub(crate) fn stripes() -> usize {
+    static N: std::sync::OnceLock<usize> = std::sync::OnceLock::new();
+    *N.get_or_init(|| {
+        std::env::var("VICTORY_MADE_STRIPES")
+            .ok()
+            .and_then(|v| v.trim().parse::<usize>().ok())
+            .map_or(1, |n| n.clamp(1, 1 << 16).next_power_of_two())
+    })
+}
+
+/// `VICTORY_MADE_CHECK=1`: after a sync mirrored slots on several threads,
+/// each is looked at once more on the submitting thread and a slot whose
+/// key is neither the record's nor "left for later" is counted and said
+/// (diagnostics of the striped locks; costs a pass over the slots).
+pub(crate) fn check() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_MADE_CHECK").is_some_and(|v| v != "0"))
+}
+
+impl Made {
+    /// `count` slots, every key 0 (never made), with [`stripes`] locks.
+    pub(crate) fn new(count: usize) -> Self {
+        Self::with_stripes(count, stripes())
+    }
+
+    /// `count` slots behind `stripes` locks (rounded up to a power of two).
+    pub(crate) fn with_stripes(count: usize, stripes: usize) -> Self {
+        let stripes = stripes.max(1).next_power_of_two();
+        Self {
+            keys: (0..count).map(|_| AtomicU64::new(0)).collect(),
+            stripes: (0..stripes).map(|_| Mutex::new(())).collect(),
+        }
+    }
+
+    /// More than one lock: readers may answer from the keys alone.
+    pub(crate) fn striped(&self) -> bool {
+        self.stripes.len() > 1
+    }
+
+    fn stripe_of(&self, index: usize) -> usize {
+        index & (self.stripes.len() - 1)
+    }
+
+    /// Slot `index`'s key without its lock: the key from before or after
+    /// any change under way. `None` past the slots.
+    pub(crate) fn get(&self, index: u32) -> Option<u64> {
+        self.keys.get(index as usize).map(|k| k.load(Ordering::Acquire))
+    }
+
+    /// Holds slot `index` (and the others of its stripe). `None` past the
+    /// slots.
+    pub(crate) fn lock(&self, index: u32) -> Option<Slot<'_>> {
+        let index = index as usize;
+        if index >= self.keys.len() {
+            return None;
+        }
+        let stripe = self.stripes[self.stripe_of(index)].lock().unwrap_or_else(|e| e.into_inner());
+        Some(Slot { made: self, index, _stripe: stripe })
+    }
+
+    /// Holds slot `index` and gives it to `change` if its key is still
+    /// `expected`: for a slot of another stripe than the one a caller held
+    /// when it decided to change it (it releases its own first). Whether
+    /// `change` ran.
+    pub(crate) fn change_if(&self, index: u32, expected: u64, change: impl FnOnce(&mut Slot<'_>)) -> bool {
+        let Some(mut slot) = self.lock(index) else {
+            return false;
+        };
+        if slot.key() != expected {
+            return false;
+        }
+        change(&mut slot);
+        true
+    }
+
+    /// Every slot's key, without the locks (diagnostics, counts).
+    pub(crate) fn keys(&self) -> impl Iterator<Item = u64> + '_ {
+        self.keys.iter().map(|k| k.load(Ordering::Acquire))
+    }
+}
+
+impl Slot<'_> {
+    pub(crate) fn index(&self) -> u32 {
+        self.index as u32
+    }
+
+    pub(crate) fn key(&self) -> u64 {
+        self.made.keys[self.index].load(Ordering::Acquire)
+    }
+
+    /// Sets the slot's key; its descriptor is written already.
+    pub(crate) fn set(&mut self, key: u64) {
+        self.made.keys[self.index].store(key, Ordering::Release);
+    }
+
+    /// Takes the slot's key (0 from here on).
+    pub(crate) fn take(&mut self) -> u64 {
+        self.made.keys[self.index].swap(0, Ordering::AcqRel)
+    }
+
+    /// Whether slot `other` is behind the lock this holds, so that it may
+    /// be changed through [`Slot::peer`] without another lock.
+    pub(crate) fn holds(&self, other: u32) -> bool {
+        let other = other as usize;
+        other < self.made.keys.len() && self.made.stripe_of(other) == self.made.stripe_of(self.index)
+    }
+
+    /// Slot `other` of the same stripe, held by this lock. `None` if it is
+    /// of another stripe (or past the slots): release this first and use
+    /// [`Made::change_if`].
+    pub(crate) fn peer(&mut self, other: u32) -> Option<Peer<'_>> {
+        self.holds(other).then_some(Peer { made: self.made, index: other as usize })
+    }
+}
+
+/// A slot of the stripe a [`Slot`] holds, other than the slot itself.
+pub(crate) struct Peer<'a> {
+    made: &'a Made,
+    index: usize,
+}
+
+impl Peer<'_> {
+    #[cfg(test)]
+    pub(crate) fn index(&self) -> u32 {
+        self.index as u32
+    }
+
+    pub(crate) fn set(&mut self, key: u64) {
+        self.made.keys[self.index].store(key, Ordering::Release);
+    }
+
+    pub(crate) fn take(&mut self) -> u64 {
+        self.made.keys[self.index].swap(0, Ordering::AcqRel)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::Arc;
+    use std::sync::atomic::AtomicUsize;
+
+    #[test]
+    fn one_stripe_holds_every_slot() {
+        let made = Made::with_stripes(10, 1);
+        assert!(!made.striped());
+        let slot = made.lock(3).unwrap();
+        for other in 0..10 {
+            assert!(slot.holds(other));
+        }
+        assert!(!slot.holds(10));
+        assert!(made.lock(10).is_none());
+        assert_eq!(made.get(10), None);
+    }
+
+    #[test]
+    fn stripes_are_by_index_modulo_their_count() {
+        let made = Made::with_stripes(100, 5);
+        assert!(made.striped());
+        assert_eq!(made.stripes.len(), 8);
+        let mut slot = made.lock(3).unwrap();
+        assert!(slot.holds(11) && slot.holds(3 + 8 * 12));
+        assert!(!slot.holds(4));
+        slot.set(7);
+        assert_eq!(slot.key(), 7);
+        let mut peer = slot.peer(11).unwrap();
+        assert_eq!(peer.index(), 11);
+        peer.set(9);
+        assert!(slot.peer(4).is_none());
+        drop(slot);
+        assert_eq!(made.get(3), Some(7));
+        assert_eq!(made.get(11), Some(9));
+        assert_eq!(made.keys().filter(|&k| k != 0).count(), 2);
+        let mut slot = made.lock(11).unwrap();
+        assert_eq!(slot.take(), 9);
+        assert_eq!(slot.take(), 0);
+    }
+
+    #[test]
+    fn change_if_only_changes_an_unchanged_slot() {
+        let made = Made::with_stripes(16, 4);
+        made.lock(5).unwrap().set(42);
+        // Changed meanwhile: left alone.
+        assert!(!made.change_if(5, 41, |s| s.set(0)));
+        assert_eq!(made.get(5), Some(42));
+        assert!(made.change_if(5, 42, |s| s.set(0)));
+        assert_eq!(made.get(5), Some(0));
+        assert!(!made.change_if(16, 0, |_| panic!()));
+    }
+
+    /// The stress of the design: threads making random slots (write a
+    /// "descriptor", then the key, under the slot), reading others
+    /// without the lock, and nulling slots of other stripes through
+    /// `change_if`. Every key read without the lock must be one a thread
+    /// wrote with the matching descriptor, and at the end each slot's key
+    /// and descriptor must match.
+    #[test]
+    fn keys_and_descriptors_agree_under_contention() {
+        const SLOTS: usize = 256;
+        const THREADS: u64 = 8;
+        const ROUNDS: usize = 20_000;
+        let made = Arc::new(Made::with_stripes(SLOTS, 16));
+        // The "descriptor heap": what was written for the key.
+        let heap: Arc<Vec<AtomicU64>> = Arc::new((0..SLOTS).map(|_| AtomicU64::new(0)).collect());
+        let torn = Arc::new(AtomicUsize::new(0));
+        let threads: Vec<_> = (1..=THREADS)
+            .map(|t| {
+                let (made, heap, torn) = (made.clone(), heap.clone(), torn.clone());
+                std::thread::spawn(move || {
+                    // A small deterministic generator per thread.
+                    let mut x = t.wrapping_mul(0x9E37_79B9_7F4A_7C15);
+                    let mut next = || {
+                        x ^= x << 13;
+                        x ^= x >> 7;
+                        x ^= x << 17;
+                        x
+                    };
+                    for round in 0..ROUNDS {
+                        let index = (next() % SLOTS as u64) as u32;
+                        let key = (t << 56) | (round as u64 + 1);
+                        match next() % 4 {
+                            // Make the slot: descriptor, then key.
+                            0 | 1 => {
+                                let mut slot = made.lock(index).unwrap();
+                                heap[index as usize].store(key, Ordering::Release);
+                                slot.set(key);
+                                // A peer of the same stripe is made null.
+                                let other = (index + 16 * (1 + (next() % 3) as u32)) % SLOTS as u32;
+                                if let Some(mut peer) = slot.peer(other) {
+                                    heap[other as usize].store(0, Ordering::Release);
+                                    peer.take();
+                                }
+                            }
+                            // Null a slot of another stripe, if unchanged.
+                            2 => {
+                                let other = (index + 1) % SLOTS as u32;
+                                let expected = made.get(other).unwrap();
+                                made.change_if(other, expected, |slot| {
+                                    assert_eq!(slot.key(), expected);
+                                    heap[slot.index() as usize].store(0, Ordering::Release);
+                                    slot.take();
+                                });
+                            }
+                            // Read without the lock: the key must be one
+                            // whose descriptor is written; holding the
+                            // stripe, descriptor and key must agree.
+                            _ => {
+                                let k = made.get(index).unwrap();
+                                if k != 0 {
+                                    let slot = made.lock(index).unwrap();
+                                    let now = slot.key();
+                                    if heap[index as usize].load(Ordering::Acquire) != now {
+                                        torn.fetch_add(1, Ordering::Relaxed);
+                                    }
+                                }
+                            }
+                        }
+                    }
+                })
+            })
+            .collect();
+        for thread in threads {
+            thread.join().unwrap();
+        }
+        assert_eq!(torn.load(Ordering::Relaxed), 0);
+        for (i, key) in made.keys().enumerate() {
+            assert_eq!(heap[i].load(Ordering::Acquire), key, "slot {i}");
+        }
+    }
+
+    /// A measure without the game (`cargo test -p victory-gpu --lib
+    /// slots::tests::stripes_bench -- --ignored --nocapture`): one
+    /// "submitting" thread taking slots in order while 7 others take
+    /// random ones, each holding a slot for about the time a mirror
+    /// takes (a short spin), with 1 stripe and with 1024.
+    #[test]
+    #[ignore]
+    fn stripes_bench() {
+        const SLOTS: usize = 1 << 17;
+        const EACH: usize = 200_000;
+        for stripes in [1usize, 1024] {
+            let made = Arc::new(Made::with_stripes(SLOTS, stripes));
+            let started = std::time::Instant::now();
+            let sync_ns = Arc::new(AtomicU64::new(0));
+            let threads: Vec<_> = (0..8u64)
+                .map(|t| {
+                    let (made, sync_ns) = (made.clone(), sync_ns.clone());
+                    std::thread::spawn(move || {
+                        let mut x = (t + 1).wrapping_mul(0x9E37_79B9_7F4A_7C15);
+                        let began = std::time::Instant::now();
+                        for n in 0..EACH {
+                            let index = if t == 0 {
+                                (n % SLOTS) as u32
+                            } else {
+                                x ^= x << 13;
+                                x ^= x >> 7;
+                                x ^= x << 17;
+                                (x % SLOTS as u64) as u32
+                            };
+                            let mut slot = made.lock(index).unwrap();
+                            // The work of a mirror: a few hundred ns.
+                            let mut acc = slot.key();
+                            for i in 0..40u64 {
+                                acc = acc.wrapping_mul(0x100000001b3).wrapping_add(i);
+                                std::hint::black_box(acc);
+                            }
+                            slot.set(acc | 1);
+                        }
+                        if t == 0 {
+                            sync_ns.store(began.elapsed().as_nanos() as u64, Ordering::Relaxed);
+                        }
+                    })
+                })
+                .collect();
+            for thread in threads {
+                thread.join().unwrap();
+            }
+            let total = started.elapsed();
+            println!(
+                "stripes {stripes}: 8 threads x {EACH} slots in {:.1} ms; the in-order thread took {:.1} ms ({:.0} ns a slot)",
+                total.as_secs_f64() * 1e3,
+                sync_ns.load(Ordering::Relaxed) as f64 / 1e6,
+                sync_ns.load(Ordering::Relaxed) as f64 / EACH as f64
+            );
+        }
+    }
+
