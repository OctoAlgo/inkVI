+        return LoopLimits {
+            pixel: n,
+            vertex: n,
+            compute: n,
+            trace: n,
+        };
+    }
+    for pair in value.split(',') {
+        let Some((stage, n)) = pair.split_once(':') else {
+            continue;
+        };
+        let Some(n) = number(n) else {
+            continue;
+        };
+        match stage.trim() {
+            "pixel" => limits.pixel = n,
+            "vertex" => limits.vertex = n,
+            "compute" => limits.compute = n,
+            "trace" => limits.trace = n,
+            _ => {}
+        }
+    }
+    limits
