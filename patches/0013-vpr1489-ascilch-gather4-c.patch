 crates/victory-shader/src/emit/lower.rs      |  30 +-
 crates/victory-shader/src/emit/valu_tests.rs | 282 +++++++++++++++++++
 2 files changed, 310 insertions(+), 2 deletions(-)

diff --git a/crates/victory-shader/src/emit/lower.rs b/crates/victory-shader/src/emit/lower.rs
index c1a2b1a52..533f21932 100644
--- a/crates/victory-shader/src/emit/lower.rs
+++ b/crates/victory-shader/src/emit/lower.rs
@@ -10236,6 +10236,7 @@ impl<'a> Lower<'a> {
