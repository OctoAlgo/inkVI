-/// Whether a dispatch waits for its compute pipeline until it is made,
-/// whatever the frame's budget ([`wait_budget`]); a draw still waits within
-/// the budget and is dropped while its pipeline is not there.
-///
-/// A dropped draw is drawn again in the next frame. A dropped dispatch may
-/// not be: the title runs some compute passes once, when a scene changes
-/// (a buffer reset or cleared), and what they leave is read for as long as
-/// the scene lasts. In the prison corridor a compute program met for the
-/// first time took 4.4 s to make on a 16 GB machine; its one dispatch was
-/// dropped after the half second of budget, and the windows of the room
-/// before stayed blended over the whole picture for minutes (run 195).
-/// A wait of seconds once (the pipeline library has it on the next run)
-/// against a picture wrong until the scene ends.
-/// On by default; `VICTORY_PIPELINE_COMPUTE_WAIT=0`: within the budget, as
-/// before.
-fn compute_waits() -> bool {
-    static ON: OnceLock<bool> = OnceLock::new();
-    *ON.get_or_init(|| std::env::var_os("VICTORY_PIPELINE_COMPUTE_WAIT").is_none_or(|v| v != "0"))
+/// `VICTORY_PIPELINE_WAIT_EARLY_MS=<ms>` (off unless set): while pipelines
+/// listed for an early start are still queued, a draw or dispatch that is
+/// the first to ask for a pipeline not made yet waits for it up to <ms>
+/// (once per pipeline, outside the frame's budget) instead of being dropped.
+/// Round 9b's dark cell: when the host pipelines are not in the driver's
+/// shader cache (a new build's first run; the 1 GB NVIDIA cache cleaned
+/// up), each early pipeline takes the driver 1-5 s, the queue needs
+/// minutes, the world starts meanwhile and its first passes go out without
+/// their pipelines (`VICTORY_PIPELINE_WAIT_MS=0`): the cell stays dark.
+fn early_wait() -> Duration {
+    static MS: OnceLock<Duration> = OnceLock::new();
+    *MS.get_or_init(|| {
+        let ms = std::env::var("VICTORY_PIPELINE_WAIT_EARLY_MS")
+            .ok()
+            .and_then(|v| v.trim().parse::<u64>().ok())
+            .unwrap_or(0);
+        if ms > 0 {
+            tracing::info!(ms, "a pipeline's first draw waits for it while early pipelines are queued");
+        }
+        Duration::from_millis(ms)
+    })
+}
+
+/// Entries in the queue's early list (stale ones included).
+static EARLY_LEFT: AtomicU64 = AtomicU64::new(0);
+/// First draws that waited under [`early_wait`]: how many, and how many
+/// got their pipeline in time.
+pub(crate) static EARLY_WAITS: [AtomicU64; 2] = [const { AtomicU64::new(0) }; 2];
+
+fn wait_once(p: &Pending, most: Duration) {
+    let started = Instant::now();
+    let (lock, done) = &DONE;
+    let mut held = lock.lock().unwrap_or_else(|e| e.into_inner());
+    while p.made.get().is_none() {
+        let rest = most.saturating_sub(started.elapsed());
+        if rest.is_zero() {
+            break;
+        }
+        held = done.wait_timeout(held, rest).unwrap_or_else(|e| e.into_inner()).0;
+    }
+    drop(held);
+    EARLY_WAITS[0].fetch_add(1, Ordering::Relaxed);
+    if p.made.get().is_some() {
+        EARLY_WAITS[1].fetch_add(1, Ordering::Relaxed);
+    }
+    crate::framelog::add(crate::framelog::T::PipelineWaitUs, started.elapsed().as_micros() as u64);
 }
 
 /// Pipelines made again for the formats bound at a draw, since the start.
@@ -385,6 +414,7 @@ impl Queue {
             self.requested.push_back(p.clone());
         } else {
             self.early.push_back(p.clone());
+            EARLY_LEFT.fetch_add(1, Ordering::Relaxed);
         }
         Some(prev == NOT_QUEUED)
     }
@@ -392,7 +422,13 @@ impl Queue {
     fn pop(&mut self) -> Option<Arc<Pending>> {
         let p = self.requested.pop_front().or_else(|| {
             // An early entry can have been promoted and claimed already.
-            std::iter::from_fn(|| self.early.pop_front())
+            std::iter::from_fn(|| {
+                let p = self.early.pop_front();
+                if p.is_some() {
+                    EARLY_LEFT.fetch_sub(1, Ordering::Relaxed);
+                }
+                p
+            })
                 .find(|p| p.queue_state.load(Ordering::Relaxed) == EARLY)
         })?;
         p.queue_state.store(MAKING, Ordering::Relaxed);
@@ -537,6 +573,8 @@ fn watch() {
                 made = MADE.load(Ordering::Relaxed),
                 loaded = LOADED.load(Ordering::Relaxed),
                 started_early = EARLY.load(Ordering::Relaxed),
+                first_waits = EARLY_WAITS[0].load(Ordering::Relaxed),
+                first_waits_made = EARLY_WAITS[1].load(Ordering::Relaxed),
                 workers = %workers.join(" "),
                 calls = %super::library::calls_now(),
                 "pipeline workers"
