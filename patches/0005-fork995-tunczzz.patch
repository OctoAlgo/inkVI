+            std::thread::spawn(move || {
+                for _ in 0..300 {
+                    let changing = title_memory_remapping();
+                    std::thread::sleep(Duration::from_millis(1));
+                    drop(changing);
+                    ended.fetch_add(1, Ordering::SeqCst);
