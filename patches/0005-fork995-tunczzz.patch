+            drop(texture);
+            collect();
+            assert!(WAITING.lock().unwrap().is_empty(), "the run went back with the texture's last reference");
+            let pool = POOL.lock().unwrap();
+            assert!(pool.iter().flatten().all(|h| h.free == vec![(0, HEAP_PAGES)]), "every page free again");
+        }
