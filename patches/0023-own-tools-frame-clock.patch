+//! LOCAL (tools-iter, never pushed): a world-frame clock for short,
+//! repeatable test runs.
+//!
+//! World frame 0 is the first present after which 500 or more draws ran on
+//! the host since the present before it: the rule `VICTORY_SHOT_AT` counts
+//! from, so shot numbers and key frames use the same clock. Below 15 fps the
+//! title's step is clamped to 1/15 s, so a world frame number names the same
+//! moment of game time in every run, whatever the frame rate.
+//!
+//! * [`world_frame`]: world frames presented so far (for frame-keyed
+//!   `VICTORY_KEYS` entries, `w<N>[-<M>]:<key>`).
+//! * `VICTORY_MARKS=<n>`: an info line every `n` world frames with the
+//!   seconds since world frame 0 (`tools/iter/wfps.py` reads them).
+//! * `VICTORY_WINDOW=<a>-<b>`: at world frame `b` a line with the window's
+//!   frames, seconds and fps; with `VICTORY_EXIT_AFTER_WINDOW=1` the process
+//!   then ends (exit code 0), so a run lasts only as long as it must.
+//! * `VICTORY_TOUCH_AT=<w>,<w>...` with `VICTORY_TOUCH_FILE=<path>`: at
+//!   each of those world frames the file is written (`1`): an outside tool
+//!   waiting for it acts on a known frame (RenderDoc's trigger file, rdhook).
+
+use std::sync::OnceLock;
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::time::Instant;
+
+/// The present number of world frame 0 (`u64::MAX` before it).
+static WORLD: AtomicU64 = AtomicU64::new(u64::MAX);
+/// The present number of the last present.
+static LAST: AtomicU64 = AtomicU64::new(0);
+
+/// Presents so far (frame-keyed `f<N>` keys).
+pub fn presents() -> u64 {
+    LAST.load(Relaxed)
+}
+
+/// World frames presented so far, once the world has begun.
+pub fn world_frame() -> Option<u64> {
+    let world = WORLD.load(Relaxed);
+    (world != u64::MAX).then(|| LAST.load(Relaxed).saturating_sub(world))
+}
+
+struct Setup {
+    touch: Vec<u64>,
+    touch_file: Option<std::path::PathBuf>,
+    marks: u64,
+    window: Option<(u64, u64)>,
+    exit: bool,
+}
+
+fn setup() -> &'static Setup {
+    static SETUP: OnceLock<Setup> = OnceLock::new();
+    SETUP.get_or_init(|| {
+        let marks = std::env::var("VICTORY_MARKS").ok().and_then(|v| v.trim().parse().ok()).unwrap_or(0);
+        let window = std::env::var("VICTORY_WINDOW").ok().and_then(|v| {
+            let (a, b) = v.trim().split_once('-')?;
+            Some((a.parse().ok()?, b.parse().ok()?))
+        });
+        let exit = std::env::var_os("VICTORY_EXIT_AFTER_WINDOW").is_some_and(|v| v == "1");
+        if marks > 0 || window.is_some() {
+            tracing::info!(marks, ?window, exit, "world-frame clock on (VICTORY_MARKS / VICTORY_WINDOW)");
+        }
+        let touch = std::env::var("VICTORY_TOUCH_AT")
+            .unwrap_or_default()
+            .split(',')
+            .filter_map(|w| w.trim().parse().ok())
+            .collect();
+        let touch_file = std::env::var_os("VICTORY_TOUCH_FILE").map(std::path::PathBuf::from);
+        Setup { touch, touch_file, marks, window, exit }
+    })
+}
+
+/// At the present of `frame` (counted from 1), with `drawn` draws run on
+/// the host so far.
+pub(crate) fn present(frame: u64, drawn: u64) {
+    static DRAWN: AtomicU64 = AtomicU64::new(0);
+    static START: OnceLock<Instant> = OnceLock::new();
+    static WINDOW_START: OnceLock<Instant> = OnceLock::new();
+    static MARK: std::sync::Mutex<Option<Instant>> = std::sync::Mutex::new(None);
+    LAST.store(frame, Relaxed);
+    if drawn.saturating_sub(DRAWN.swap(drawn, Relaxed)) >= 500
+        && WORLD.compare_exchange(u64::MAX, frame, Relaxed, Relaxed).is_ok()
+    {
+        START.get_or_init(Instant::now);
+        tracing::info!(present = frame, "world frame 0 (the first present after 500 draws or more)");
+    }
+    let Some(w) = world_frame() else { return };
+    let s = setup();
+    let now = Instant::now();
+    let since = START.get().map_or(0.0, |t| now.duration_since(*t).as_secs_f64());
+    if let Some(file) = &s.touch_file {
+        if s.touch.contains(&w) {
+            let r = std::fs::write(file, b"1");
+            tracing::info!(world_frame = w, ok = r.is_ok(), "VICTORY_TOUCH_AT: file written");
+        }
+    }
+    if s.marks > 0 && w > 0 && w.is_multiple_of(s.marks) {
+        let mut last = MARK.lock().unwrap_or_else(|e| e.into_inner());
+        let fps = last.map_or(0.0, |t| s.marks as f64 / now.duration_since(t).as_secs_f64());
+        *last = Some(now);
+        tracing::info!(world_frame = w, secs = format!("{since:.3}"), fps = format!("{fps:.3}"), "world frame mark");
+    }
+    if let Some((a, b)) = s.window {
+        if w == a {
+            WINDOW_START.get_or_init(|| now);
+            tracing::info!(world_frame = w, secs = format!("{since:.3}"), "measured window begins (VICTORY_WINDOW)");
+        }
+        if w == b {
+            if let Some(t) = WINDOW_START.get() {
+                let secs = now.duration_since(*t).as_secs_f64();
+                tracing::info!(
+                    from = a,
+                    to = b,
+                    secs = format!("{secs:.3}"),
+                    fps = format!("{:.4}", (b - a) as f64 / secs),
+                    ms = format!("{:.2}", 1000.0 * secs / (b - a) as f64),
+                    "measured window ends (VICTORY_WINDOW)"
+                );
+            }
+            if s.exit {
+                tracing::info!("VICTORY_EXIT_AFTER_WINDOW=1: ending the process");
+                #[cfg(windows)]
+                // SAFETY: plain calls; the run is over.
+                unsafe {
+                    use windows_sys::Win32::System::Threading::{GetCurrentProcess, TerminateProcess};
+                    TerminateProcess(GetCurrentProcess(), 0);
+                }
+                std::process::exit(0);
+            }
+        }
+    }
+}
