+    if began && last {
+        end_run(list, run.take());
+        return None;
+    }
+    if began {
+        end_run(list, run.take());
+        *run = begin_run(list, src_gpu, count.map(|(b, _)| b), bytes);
+        if run.is_none() {
+            CALLS[RUN_REFUSED].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+            return None;
+        }
