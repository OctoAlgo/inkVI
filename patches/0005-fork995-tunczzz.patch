+/// [`SKINNED`]'s ranges and bytes now.
+pub(crate) fn skinned_known() -> (usize, u64) {
+    let map = SKINNED.lock().unwrap_or_else(|e| e.into_inner());
+    (map.len(), map.iter().map(|(&start, &(end, _, _))| end - start).sum())
