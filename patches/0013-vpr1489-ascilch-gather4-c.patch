@@ -10660,6 +10671,21 @@ impl<'a> Lower<'a> {
                         }
                         gathered = Some(g);
                         read.expect("four reads")
+                    } else if op == 74 {
+                        // Comparison gather (Marvisak/VIctory #1489, AscilCH): the
