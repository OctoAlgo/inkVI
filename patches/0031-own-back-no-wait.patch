diff --git a/crates/victory-gpu/src/host/back_no_wait.rs b/crates/victory-gpu/src/host/back_no_wait.rs
new file mode 100644
index 000000000..f713529ec
--- /dev/null
+++ b/crates/victory-gpu/src/host/back_no_wait.rs
@@ -0,0 +1,277 @@
+//! A title buffer copy into memory that flights' shaders may write, run
+//! without waiting for them (`VICTORY_BACK_NO_WAIT=1`; off by default:
+//! unset or `0` is the behaviour before it). LOCAL (daily-pr8).
+//!
+//! What it is for: a title buffer copy deferred into a list (`Step::Copy`)
+//! is run on the CPU when the list is submitted. If its source or its
+//! destination touches the ranges flights in the air declared their shaders
+//! write (`Line::written`), the submission waited until those flights had
+//! landed ([`super::Host::relay_read_wait`]): about 38 ms of the submitting
+//! thread a frame on the desktop, one such wait a frame. A copy whose
+//! source lies there and whose destination does not is not waited for
+//! anyway (`copy_ahead`); what was left are copies INTO such memory.
+//!
+//! Why such a copy need not wait: on the console it is a command of the
+//! submission's list, run after every earlier submission in queue order;
+//! its bytes are newer than whatever those flights' shaders wrote there.
+//! So with the switch a copy whose source is clear of flights' writes and
+//! whose destination touches them runs at once, and:
+//!
+//! 1. its destination is marked fresher than every flight numbered below
+//!    the submission it belongs to ([`ran`]): each landing path that writes
+//!    title memory for flights below the mark leaves the marked bytes alone
+//!    (`Shadow::relay_merge`, `Shadow::card_merge_relay` with the number of
+//!    the last flight of the landing, [`landing`]; the read-backs and
+//!    texture read-backs with their own flight's, `read_backs`). A landing
+//!    of flights some of which are not below the mark leaves nothing out:
+//!    the card's bytes there may be the later flight's own, which win;
+//! 2. the bytes it wrote are put at once into the host copies those flights
+//!    hold the memory in (`Shadow::fresher_push`): the copy's PC-side bytes
+//!    and its snapshot (the merge's reference), or the CPU side of a copy in
+//!    the card's memory, whose changed bytes go up ahead of the submission's
+//!    lists. The refresh leaves ranges shaders write alone, so without this
+//!    the submission's own shaders would read the old bytes there, and a
+//!    later merge would take the card's old bytes for a shader's write.
+//!
+//! A copy whose source touches flights' writes still waits exactly as
+//! before. The switch is taken only with the relay's second stage (the
+//! default) and copies in the card's memory with a CPU side (not
+//! `VICTORY_CARD_NO_PC_COPY=2`, whose mirror may not hold a piece).
+//!
+//! Order between a landing's write and the copy: a landing path looks at
+//! the marks and writes title memory inside a [`Writing`] window; the copy
+//! records its mark, then waits until no such window is open, then writes.
+//! Either the landing saw the mark, or the copy came after its write.
+
+use std::sync::atomic::{AtomicU64, AtomicUsize, Ordering};
+use std::sync::{Mutex, OnceLock};
+
+/// Whether the switch is on and taken.
+pub(crate) fn on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| {
+        if !std::env::var_os("VICTORY_BACK_NO_WAIT").is_some_and(|v| v == "1") {
+            return false;
+        }
+        let taken = super::relay_exact() && !crate::shadow::no_pc_copy();
+        if taken {
+            tracing::info!(
+                "VICTORY_BACK_NO_WAIT=1: title copies into memory flights' shaders may write run at once, \
+                 their destination marked fresher than those flights' landing"
+            );
+        } else {
+            tracing::warn!(
+                "VICTORY_BACK_NO_WAIT=1 is not taken: it needs the relay's second stage (VICTORY_RELAY unset or 2, \
+                 flights sent ahead) and copies in the card's memory with a CPU side (not VICTORY_CARD_NO_PC_COPY=2)"
+            );
+        }
+        taken
+    })
+}
+
+/// A title copy's destination `[from, to)`, written by submission `number`
+/// at its preparing: newer than what flights numbered below it wrote there.
+struct Mark {
+    from: usize,
+    to: usize,
+    number: u64,
+}
+
+static MARKS: Mutex<Vec<Mark>> = Mutex::new(Vec::new());
+/// How many marks [`MARKS`] holds (the landing paths' look without a lock).
+static MARKS_N: AtomicUsize = AtomicUsize::new(0);
+/// Landing writes between their look at the marks and their store
+/// ([`Writing`]).
+static WRITERS: AtomicUsize = AtomicUsize::new(0);
+/// The number of the last flight of the landing under way (0: none): what
+/// the merges of a landing ([`skips`]) are below.
+static LANDING: AtomicU64 = AtomicU64::new(0);
+
+/// Since the last frame line: copies run at once, their bytes, the bytes
+/// put into copies flights hold, copies still waited for (source under
+/// writes), landing bytes left alone under marks, the stretches or rows
+/// that left some, microseconds the copies stood for landing writes.
+mod n {
+    pub(super) const RUN: usize = 0;
+    pub(super) const RUN_BYTES: usize = 1;
+    pub(super) const PUSHED: usize = 2;
+    pub(super) const WAITED: usize = 3;
+    pub(super) const SKIPPED: usize = 4;
+    pub(super) const SKIPS: usize = 5;
+    pub(super) const STOOD_US: usize = 6;
+    pub(super) const ALL: usize = 7;
+}
+static STATS: [AtomicU64; n::ALL] = [const { AtomicU64::new(0) }; n::ALL];
+
+fn marks() -> std::sync::MutexGuard<'static, Vec<Mark>> {
+    MARKS.lock().unwrap_or_else(|e| e.into_inner())
+}
+
+/// The landing thread lands flights up to number `last` (0: done).
+pub(super) fn landing_set(last: u64) {
+    if on() {
+        LANDING.store(last, Ordering::SeqCst);
+    }
+}
+
+/// The number of the last flight of the landing under way (0: none).
+pub(crate) fn landing() -> u64 {
+    LANDING.load(Ordering::SeqCst)
+}
+
+/// A copy still waited for because its source lies under flights' writes.
+pub(super) fn waited() {
+    STATS[n::WAITED].fetch_add(1, Ordering::Relaxed);
+}
+
+/// Marks no flight can still land under: every flight below them has.
+pub(super) fn prune() {
+    if MARKS_N.load(Ordering::SeqCst) == 0 {
+        return;
+    }
+    let finished = super::finished();
+    let mut marks = marks();
+    marks.retain(|m| finished.saturating_add(1) < m.number);
+    MARKS_N.store(marks.len(), Ordering::SeqCst);
+}
+
+/// Before submission `number`'s title copy into `[from, to)` writes title
+/// memory, which touches flights' declared writes: the mark is set, and the
+/// copy waits until no landing is between its look at the marks and its
+/// store (at most 50 ms; a landing does not wait for anything the
+/// submitting thread holds, so that bound is only a guard).
+pub(super) fn ran(from: usize, to: usize, number: u64) {
+    if from >= to {
+        return;
+    }
+    prune();
+    {
+        let mut marks = marks();
+        marks.push(Mark { from, to, number });
+        MARKS_N.store(marks.len(), Ordering::SeqCst);
+    }
+    STATS[n::RUN].fetch_add(1, Ordering::Relaxed);
+    STATS[n::RUN_BYTES].fetch_add((to - from) as u64, Ordering::Relaxed);
+    if WRITERS.load(Ordering::SeqCst) == 0 {
+        return;
+    }
+    let waiting = std::time::Instant::now();
+    while WRITERS.load(Ordering::SeqCst) != 0 {
+        if waiting.elapsed() >= std::time::Duration::from_millis(50) {
+            static ONCE: std::sync::Once = std::sync::Once::new();
+            ONCE.call_once(|| {
+                tracing::warn!("VICTORY_BACK_NO_WAIT: a title copy waited 50 ms for a landing write and went on")
+            });
+            break;
+        }
+        std::thread::yield_now();
+    }
+    STATS[n::STOOD_US].fetch_add(waiting.elapsed().as_micros() as u64, Ordering::Relaxed);
+}
+
+/// Bytes of a copy flights hold put in with the title copy's.
+pub(super) fn pushed(bytes: usize) {
+    STATS[n::PUSHED].fetch_add(bytes as u64, Ordering::Relaxed);
+}
+
+/// A landing path between its look at the marks and its store of title
+/// memory ([`skips`]); a title copy that set a mark meanwhile waits until it
+/// is dropped.
+pub(crate) struct Writing(bool);
+
+impl Drop for Writing {
+    fn drop(&mut self) {
+        if self.0 {
+            WRITERS.fetch_sub(1, Ordering::SeqCst);
+        }
+    }
+}
+
+/// For a landing path about to write title memory `[from, to)` for flights
+/// numbered up to `landed` (0: not known, nothing left out): the parts
+/// (in order, joined) under marks of later submissions, which it must
+/// leave alone, and the window to hold until its store is done.
+pub(crate) fn skips(from: usize, to: usize, landed: u64) -> (Writing, Vec<(usize, usize)>) {
+    if !on() {
+        return (Writing(false), Vec::new());
+    }
+    WRITERS.fetch_add(1, Ordering::SeqCst);
+    let writing = Writing(true);
+    if landed == 0 || from >= to || MARKS_N.load(Ordering::SeqCst) == 0 {
+        return (writing, Vec::new());
+    }
+    let parts: Vec<(usize, usize)> = marks()
+        .iter()
+        .filter(|m| m.number > landed && m.from < to && m.to > from)
+        .map(|m| (m.from.max(from), m.to.min(to)))
+        .collect();
+    (writing, joined(parts))
+}
+
+/// `parts` in order, joined where they overlap or touch.
+pub(crate) fn joined(mut parts: Vec<(usize, usize)>) -> Vec<(usize, usize)> {
+    parts.retain(|p| p.0 < p.1);
+    parts.sort_unstable();
+    let mut out: Vec<(usize, usize)> = Vec::with_capacity(parts.len());
+    for (a, b) in parts {
+        match out.last_mut() {
+            Some(last) if a <= last.1 => last.1 = last.1.max(b),
+            _ => out.push((a, b)),
+        }
+    }
+    out
+}
+
+/// A landing left the bytes of `marked` (title addresses) alone in a
+/// stretch at title address `base`: counted where the card's bytes `now`
+/// differed from the reference `held` (what it would have written).
+pub(crate) fn skipped_where(base: usize, now: &[u8], held: &[u8], marked: &[(usize, usize)]) {
+    let mut bytes = 0u64;
+    for &(a, b) in marked {
+        let (a, b) = (a.saturating_sub(base).min(now.len()), b.saturating_sub(base).min(now.len()));
+        bytes += now[a..b].iter().zip(&held[a..b]).filter(|(x, y)| x != y).count() as u64;
+    }
+    skipped(bytes);
+}
+
+/// A landing left `bytes` of title memory alone under marks.
+pub(crate) fn skipped(bytes: u64) {
+    STATS[n::SKIPPED].fetch_add(bytes, Ordering::Relaxed);
+    STATS[n::SKIPS].fetch_add(1, Ordering::Relaxed);
+}
+
+/// The frame line's part, with the switch on.
+pub(super) fn line(frames: f64) {
+    if !on() {
+        return;
+    }
+    prune();
+    let s: Vec<f64> = STATS.iter().map(|s| s.swap(0, Ordering::Relaxed) as f64 / frames).collect();
+    tracing::info!(
+        "title copies under flights' writes per frame (VICTORY_BACK_NO_WAIT=1): {:.2} run at once with their destination \
+         marked fresher ({:.1} KB, {:.1} KB of it put into the copies flights hold), {:.2} still waited for (source under \
+         writes), {:.1} landing bytes skipped under marks ({:.2} stretches or rows), {:.2} ms standing for landing writes, \
+         {} marks held",
+        s[n::RUN],
+        s[n::RUN_BYTES] / 1024.0,
+        s[n::PUSHED] / 1024.0,
+        s[n::WAITED],
+        s[n::SKIPPED],
+        s[n::SKIPS],
+        s[n::STOOD_US] / 1000.0,
+        MARKS_N.load(Ordering::Relaxed),
+    );
+}
+
+#[cfg(test)]
+mod tests {
+    use super::joined;
+
+    #[test]
+    fn marks_join_and_leave_the_rest() {
+        assert_eq!(joined(vec![(30, 40), (10, 20), (15, 25), (25, 26), (50, 50)]), vec![(10, 26), (30, 40)]);
+        // What a landing then writes: the stretch without them.
+        assert_eq!(crate::shadow::outside(0, 45, joined(vec![(10, 20), (30, 50)])), vec![(0, 10), (20, 30)]);
+        assert_eq!(crate::shadow::outside(12, 18, joined(vec![(10, 20)])), Vec::<(usize, usize)>::new());
+    }
+}
