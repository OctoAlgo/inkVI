+/// `VICTORY_MADE_CHECK=1`: every record slot of a wide sync once more, on
+/// this thread: its key must be its record's (made) or 0 (left for later,
+/// or not ours). Anything else is a slot made from something else: a title
+/// write between the sync's read and now (counted "rewritten" when the
+/// record now differs and the slot shows it), or a fault of the striped
+/// locks ("wrong", said with the keys).
+#[cfg(windows)]
+fn check_mirrored(work: &[(usize, u32, u64, u64)]) {
+    use std::sync::atomic::Ordering::Relaxed;
+    static COUNTS: [std::sync::atomic::AtomicU64; 3] = [const { std::sync::atomic::AtomicU64::new(0) }; 3];
+    let (mut ok, mut rewritten, mut wrong) = (0u64, 0u64, 0u64);
+    for &(at, index, handle, key) in work {
+        // SAFETY: a host heap of a registered heap, under the heaps' lock
+        // the caller holds.
+        let host = unsafe { &*(at as *const host::HostHeap) };
+        let Some(now) = host.made_key(index) else { continue };
+        if now == 0 || now == key {
+            ok += 1;
+            continue;
+        }
+        let mut words = [0u8; 12];
+        let read = crate::host::read_into(handle as *const u8, &mut words);
+        let w = |i: usize| u32::from_le_bytes([words[i], words[i + 1], words[i + 2], words[i + 3]]);
+        let record_now = if read { host::words_key([w(0), w(4), w(8)]) } else { 0 };
+        if record_now != key && now == record_now {
+            rewritten += 1;
+        } else {
+            wrong += 1;
+            if COUNTS[2].load(Relaxed) + wrong <= 20 {
+                tracing::warn!(index, key, now, record_now, "VICTORY_MADE_CHECK: a slot the sync mirrored holds another key");
+            }
+        }
+    }
+    let totals: Vec<u64> = COUNTS.iter().zip([ok, rewritten, wrong]).map(|(c, n)| c.fetch_add(n, Relaxed) + n).collect();
+    if wrong > 0 || totals[0] == ok || (totals[0] - ok) >> 20 != totals[0] >> 20 {
+        tracing::info!(
+            ok = totals[0],
+            rewritten = totals[1],
+            wrong = totals[2],
+            "VICTORY_MADE_CHECK: slots the wide sync mirrored, looked at again"
+        );
+    }
+}
