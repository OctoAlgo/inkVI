+/// [`back_no_wait`]: before a title copy into `[dst, dst + len)` runs at
+/// submission. If that touches what flights in the air (or being landed)
+/// declared their shaders write, its mark is set (the copy then waits only
+/// for a landing write under way) and the copies those flights hold the
+/// memory in are given, to take the copy's bytes once it ran
+/// (`Shadow::fresher_push`). `None`: clear of the flights, nothing to do.
+fn fresher_copy(batch: &mut Batch, dst: usize, len: usize) -> Option<Vec<std::sync::Arc<crate::shadow::Shadow>>> {
+    let end = dst.checked_add(len)?;
+    if len == 0 || batch.number == 0 {
+        return None;
+    }
+    let written = batch.fresh_written.get_or_insert_with(|| line().written.clone());
+    if !touches(written, dst, end) {
+        return None;
+    }
+    let mut shadows: Vec<std::sync::Arc<crate::shadow::Shadow>> = Vec::new();
+    {
+        let mut line = line();
+        if !touches(&line.written, dst, end) {
+            return None;
+        }
+        // Title memory in place is what the card writes: a flight still
+        // running could write it after the copy, and no landing would put
+        // that right. Such a copy waits, as before, but only until the card
+        // has run the flights that declared it there (they leave the line
+        // for the landing). Bounded: the landing takes nothing this thread
+        // holds, so the bound is only a guard.
+        let placed = |line: &Line| {
+            line.line.iter().any(|item| match item {
+                Late::Run(flight) => flight
+                    .back
+                    .iter()
+                    .any(|(shadow, ranges)| shadow.is_placed() && ranges.iter().any(|&(a, e)| a < end && e > dst)),
+                _ => false,
+            })
+        };
+        if placed(&line) {
+            back_no_wait::waited();
+            let waiting = std::time::Instant::now();
+            while placed(&line) && waiting.elapsed() < std::time::Duration::from_secs(1) {
+                line = LINE_LANDED.wait_timeout(line, std::time::Duration::from_millis(1)).unwrap_or_else(|e| e.into_inner()).0;
+            }
+        }
+        let flying = line.line.iter().filter_map(|item| match item {
+            Late::Run(flight) => Some(flight.back.iter()),
+            _ => None,
+        });
+        for (shadow, ranges) in flying.flatten().chain(line.landing_back.iter()) {
+            if ranges.iter().any(|&(a, e)| a < end && e > dst) && !shadows.iter().any(|s| std::sync::Arc::ptr_eq(s, shadow)) {
+                shadows.push(shadow.clone());
+            }
+        }
+    }
+    back_no_wait::ran(dst, end, batch.number);
+    Some(shadows)
 }
 
