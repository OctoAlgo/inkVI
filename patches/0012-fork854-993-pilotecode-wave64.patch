diff --git a/crates/victory-shader/src/emit/idiom.rs b/crates/victory-shader/src/emit/idiom.rs
new file mode 100644
index 000000000..cd0d1fe3c
--- /dev/null
+++ b/crates/victory-shader/src/emit/idiom.rs
@@ -0,0 +1,335 @@
+//! Whether a console wave64 program's wave operations are the allocation idiom
+//! ([`wave_local`]), which each host wave may run on its own: moved out of `lower` whole.
+
+use std::collections::{HashMap, HashSet};
+
+use crate::gfx10::{Fields, NULL, Operand};
+use crate::ir::{EXEC, Inst, Program, Reg, Value};
+use crate::structure::{Atom, LaneExit, Structured};
+
+type Why = &'static str;
+
+/// What a register value holds, for [`wave_local`].
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Wave {
+    /// Nothing that depends on how the threads are divided into waves.
+    Plain,
+    /// The number of the wave's first lane in a mask (`s_ff1`).
+    First,
+    /// A reduction over the wave's lanes: a count, a sum, a minimum...
+    Total(super::wave::Op),
+    /// A count or sum over the lanes below this one.
+    Prefix,
+    /// Derived from what a first-lane atomic returned: the slots the wave reserved.
+    Base,
+    /// A mix the idiom does not make.
+    Mixed,
+}
+
+/// Whether a console wave64 program may run with each host wave as a wave of its own
+/// ([`super::lower::with_local_waves`]): its wave-wide values are used only as the allocation idiom uses
+/// them, which does not care how the threads are divided into waves. A first-lane number only
+/// picks the first lane; a count or sum only goes into that lane's atomic on a shared counter;
+/// a prefix only goes onto the base that atomic returned; the first lane does nothing else.
+/// Anything else done with them takes one wave to be the whole thread group (a tile's result,
+/// say) and is refused, with the offset and what was found.
+/// Lane masks read as numbers by other instructions and lane reads outside whole-wave sections
+/// are stopped by the lowering itself.
+// shortcut: `v_readfirstlane` of a value that differs between lanes is taken as it is (this
+// host wave's first lane), and a guarded write of a plain value over a wave-dependent one is
+// the only mix of old and new lanes that is looked at.
+pub(super) fn wave_local(p: &Program, st: &Structured) -> Result<(), (usize, &'static str)> {
+    use super::wave::{Op, Shape};
+    const FIRST: Why = "a wave's first-lane number used as data";
+    const TOTAL: Why = "a count or sum over the wave used as data";
+    const PREFIX: Why = "a count or sum over the lanes below used without a reserved base";
+    const MIXED: Why = "a value that depends on the wave on some paths only";
+    const EFFECT: Why = "a write by the wave's first lane other than its reservation";
+    fn of(kind: &HashMap<Value, Wave>, v: Option<Value>) -> Wave {
+        v.and_then(|v| kind.get(&v).copied()).unwrap_or(Wave::Plain)
+    }
+    fn put(kind: &mut HashMap<Value, Wave>, v: Value, k: Wave) {
+        if k == Wave::Plain {
+            kind.remove(&v);
+        } else {
+            kind.insert(v, k);
+        }
+    }
+    let wild = |k: Wave| !matches!(k, Wave::Plain | Wave::Base);
+    let why = |k: Wave| match k {
+        Wave::First => FIRST,
+        Wave::Total(_) => TOTAL,
+        Wave::Prefix => PREFIX,
+        _ => MIXED,
+    };
+    // a mask (by its low dword) under which only a wave's first lane runs
+    let first_mask = |firsts: &HashSet<Value>, m: Option<Value>| {
+        m.and_then(|m| st.masks.get(&m)).is_some_and(|&b| {
+            st.bools
+                .support(b)
+                .iter()
+                .any(|a| matches!(a, Atom::Lane(v) if firsts.contains(v)))
+        })
+    };
+    // One instruction outside a section: the kind of what it writes, and whether it is a
+    // first lane's reservation.
+    let step = |inst: &Inst, kind: &HashMap<Value, Wave>, firsts: &mut HashSet<Value>| -> Result<(Wave, bool), Why> {
+        let name = inst.name();
+        let val = |op: &Operand| match *op {
+            Operand::Vector { reg, .. } => inst.read(Reg::V(reg)),
+            Operand::Scalar { code, .. } if code != NULL => inst.read(Reg::S(code)),
+            _ => None,
+        };
+        let ops: Vec<Operand> = match &inst.fields {
+            Fields::Valu(v) => v.src.clone(),
+            Fields::Sop { dst, src, .. } => {
+                let mut o = src.clone();
+                if matches!(name, "s_addk_i32" | "s_mulk_i32") {
+                    o.extend(dst.iter().copied());
+                }
+                o
+            }
+            Fields::Buffer { data, .. } if name.contains("_atomic_") || name.contains("_store_") => {
+                data.iter().copied().collect()
+            }
+            _ => Vec::new(),
+        };
+        let kinds: Vec<Wave> = ops.iter().map(|o| of(kind, val(o))).collect();
+        // Everything else it reads (addresses, descriptors, SCC, the high dwords of wide
+        // operands) must not depend on the wave. Not EXEC, and not the old value of a VGPR it
+        // writes, which only the lanes outside EXEC keep.
+        let named: Vec<Value> = ops.iter().filter_map(&val).collect();
+        for &(r, v) in &inst.reads {
+            let kept = matches!(r, Reg::V(_)) && inst.writes.iter().any(|w| w.0 == r);
+            if matches!(r, Reg::S(c) if c == EXEC || c == EXEC + 1) || kept || named.contains(&v) {
+                continue;
+            }
+            let k = of(kind, Some(v));
+            if wild(k) {
+                return Err(why(k));
+            }
+        }
+        let w = kinds.iter().copied().find(|&k| wild(k)).unwrap_or(Wave::Mixed);
+        let sum = |k: Wave| k == Wave::Total(Op::AddU);
+        let is_mask = |o: &Operand| {
+            val(o).is_some_and(|v| st.masks.contains_key(&v) || st.highs.contains_key(&v))
+        };
+        let mut reserved = false;
+        let out = match (name, &kinds[..]) {
+            ("s_ff1_i32_b64" | "s_ff1_i32_b32", _) if ops.first().is_some_and(is_mask) => Wave::First,
+            ("s_bcnt1_i32_b64" | "s_bcnt1_i32_b32", _) if ops.first().is_some_and(is_mask) => {
+                Wave::Total(Op::AddU)
+            }
+            // bits of a mask below the lane; with -1 for the mask, the lane's number
+            ("v_mbcnt_lo_u32_b32" | "v_mbcnt_hi_u32_b32", [_, b]) => {
+                match (matches!(ops[0], Operand::Scalar { .. }), *b) {
+                    (_, Wave::Prefix) | (true, Wave::Plain | Wave::Base) => Wave::Prefix,
+                    (false, Wave::Plain | Wave::Base) => Wave::Plain,
+                    (_, k) => return Err(why(k)),
+                }
+            }
+            // nothing wave-dependent goes in; what derives from a reserved base stays marked
+            _ if !kinds.iter().any(|&k| wild(k)) => {
+                let derives = matches!(inst.fields, Fields::Valu(_) | Fields::Sop { .. });
+                if derives && kinds.contains(&Wave::Base) { Wave::Base } else { Wave::Plain }
+            }
+            ("v_mov_b32" | "s_mov_b32", [k]) => *k,
+            ("v_cmp_eq_i32" | "v_cmp_eq_u32" | "v_cmpx_eq_i32" | "v_cmpx_eq_u32", [a, b]) => {
+                // the lane whose own number is the first lane's
+                let lane = match (*a, *b) {
+                    (Wave::First, k) if !wild(k) => &ops[1],
+                    (k, Wave::First) if !wild(k) => &ops[0],
+                    _ => return Err(why(w)),
+                };
+                if !matches!(lane, Operand::Vector { .. }) {
+                    return Err(FIRST);
+                }
+                let mask = match &inst.fields {
+                    _ if name.starts_with("v_cmpx") => inst.write(Reg::S(EXEC)),
+                    Fields::Valu(v) => match v.dst {
+                        Some(Operand::Scalar { code, .. }) => inst.write(Reg::S(code)),
+                        _ => None,
+                    },
+                    _ => None,
+                };
+                firsts.extend(mask);
+                Wave::Plain
+            }
+            ("v_add_nc_u32" | "s_add_i32", [a, b]) => match (*a, *b) {
+                (Wave::Prefix, Wave::Base) | (Wave::Base, Wave::Prefix) => Wave::Base,
+                (Wave::Prefix, Wave::Plain | Wave::Prefix) | (Wave::Plain, Wave::Prefix) => Wave::Prefix,
+                (x, y) if sum(x) && sum(y) => x,
+                _ => return Err(why(w)),
+            },
+            ("v_sub_nc_u32" | "s_sub_i32", [a, b]) => match (*a, *b) {
+                (Wave::Base, Wave::Prefix) => Wave::Base,
+                (Wave::Prefix, Wave::Plain) => Wave::Prefix,
+                (Wave::Plain, y) if sum(y) && matches!(ops[0], Operand::Const(128)) => y,
+                _ => return Err(why(w)),
+            },
+            ("s_mul_i32" | "v_mul_lo_u32" | "v_mul_u32_u24", [a, b]) => match (*a, *b) {
+                (x, Wave::Plain) | (Wave::Plain, x) if sum(x) || x == Wave::Prefix => x,
+                _ => return Err(why(w)),
+            },
+            ("s_lshl_b32", [x, Wave::Plain]) | ("v_lshlrev_b32", [Wave::Plain, x])
+                if sum(*x) || *x == Wave::Prefix =>
+            {
+                *x
+            }
+            ("v_lshl_add_u32", [Wave::Prefix, Wave::Plain, c]) if !wild(*c) => {
+                if *c == Wave::Base { Wave::Base } else { Wave::Prefix }
+            }
+            // the prefix in units of a plain size, onto the base: the lens-flare scans reserve
+            // their count times the size, and each lane takes base + below × size
+            ("v_mad_u32_u24" | "v_mad_u32_u16", [Wave::Prefix, Wave::Plain, c] | [Wave::Plain, Wave::Prefix, c])
+                if !wild(*c) =>
+            {
+                if *c == Wave::Base { Wave::Base } else { Wave::Prefix }
+            }
+            // the reservation: the first lane adds its wave's total to a shared counter
+            (_, [Wave::Total(op)]) if name.contains("_atomic_") => {
+                let want = match op {
+                    Op::AddU => "buffer_atomic_add",
+                    Op::MinU => "buffer_atomic_umin",
+                    Op::MaxU => "buffer_atomic_umax",
+                    Op::MinI => "buffer_atomic_smin",
+                    Op::MaxI => "buffer_atomic_smax",
+                    Op::Or => "buffer_atomic_or",
+                    Op::And => "buffer_atomic_and",
+                    Op::Xor => "buffer_atomic_xor",
+                    _ => "",
+                };
+                if name != want || !first_mask(firsts, inst.read(Reg::S(EXEC))) {
+                    return Err(TOTAL);
+                }
+                reserved = true;
+                Wave::Base
+            }
+            _ => return Err(why(w)),
+        };
+        Ok((out, reserved))
+    };
+    let sections: Vec<_> = (0..p.blocks.len()).map(|b| super::wave::sections(p, b)).collect();
+    // guarded writes whose old lanes no lane reads (`split::read_inside_only`)
+    let inside = if super::split::on() { super::split::read_inside_only(p, st) } else { HashSet::new() };
+    let order = crate::ir::reverse_postorder(&p.blocks);
+    let pass = |kind: &mut HashMap<Value, Wave>, firsts: &mut HashSet<Value>, check: bool| -> Result<(), (usize, Why)> {
+        for &b in &order {
+            let block = &p.blocks[b];
+            for phi in &block.phis {
+                let mut k = Wave::Plain;
+                for (n, &a) in phi.args.iter().enumerate() {
+                    let x = of(kind, Some(a));
+                    k = match (k, x) {
+                        _ if n == 0 => x,
+                        (k, x) if k == x => k,
+                        (Wave::Plain, m @ (Wave::Base | Wave::Prefix))
+                        | (m @ (Wave::Base | Wave::Prefix), Wave::Plain) => m,
+                        _ => Wave::Mixed,
+                    };
+                }
+                put(kind, phi.value, k);
+            }
+            for (i, inst) in block.insts.iter().enumerate() {
+                // inside a whole-wave section: what the simulation found each value to be
+                if let Some((_, sec)) = sections[b].iter().find(|(s, sec)| i > **s && i < sec.end) {
+                    for &(_, w) in &inst.writes {
+                        let k = match sec.shapes.get(&w) {
+                            None => Wave::Mixed,
+                            Some(&Shape::K(_)) => Wave::Plain,
+                            Some(&Shape::Value(v)) => of(kind, Some(v)),
+                            Some(&Shape::Masked(src, _, _)) => of(kind, Some(src)),
+                            Some(&Shape::Active(op, src, mask, _)) => match of(kind, Some(src)) {
+                                Wave::Plain | Wave::Base => Wave::Total(op),
+                                // the first lane's own sum of a total is that total
+                                Wave::Total(o) if o == op && first_mask(firsts, Some(mask)) => Wave::Total(op),
+                                _ => Wave::Mixed,
+                            },
+                            Some(&Shape::Prefix(Op::AddU, src, mask, _, _)) => match of(kind, Some(src)) {
+                                Wave::Plain | Wave::Base => Wave::Prefix,
+                                Wave::Total(Op::AddU) if first_mask(firsts, Some(mask)) => Wave::Prefix,
+                                _ => Wave::Mixed,
+                            },
+                            Some(_) => Wave::Mixed,
+                        };
+                        put(kind, w, k);
+                    }
+                    continue;
+                }
+                let name = inst.name();
+                if name.starts_with("s_cbranch") {
+                    continue; // with the block's exit, below
+                }
+                let (k, reserved) = match step(inst, kind, firsts) {
+                    Ok(r) => r,
+                    Err(why) if check => return Err((inst.machine.offset, why)),
+                    Err(_) => (Wave::Mixed, false),
+                };
+                // the same test as `Lower::inst`'s `effect`
+                let effect = matches!(inst.fields, Fields::Exp { .. })
+                    || matches!(inst.fields, Fields::Flat { .. }) && !name.starts_with("global_load_")
+                    || name.contains("store")
+                    || name.contains("atomic")
+                    || matches!(inst.fields, Fields::Ds { .. })
+                        && !(name.starts_with("ds_read")
+                            || name.starts_with("ds_swizzle")
+                            || name.contains("permute"));
+                if check && effect && !reserved && first_mask(firsts, inst.read(Reg::S(EXEC))) {
+                    return Err((inst.machine.offset, EFFECT));
+                }
+                let guarded = st.guards[b][i].is_some();
+                for &(r, w) in &inst.writes {
+                    let mut kw = match r {
+                        // "some lane is counted" keeps the count's kind; any other SCC is one bit of data
+                        Reg::Scc if !name.starts_with("s_bcnt1") => {
+                            if wild(k) { Wave::Mixed } else { Wave::Plain }
+                        }
+                        _ => k,
+                    };
+                    // a guarded write leaves the old value in the lanes outside EXEC (where a
+                    // lane reads it)
+                    if guarded
+                        && matches!(r, Reg::V(_))
+                        && kw == Wave::Plain
+                        && !inside.contains(&w)
+                        && matches!(of(kind, inst.read(r)), Wave::First | Wave::Total(_) | Wave::Prefix)
+                    {
+                        kw = Wave::Mixed;
+                    }
+                    put(kind, w, kw);
+                }
+            }
+            // a branch on "some lane is counted": fine where the structure made it the lane's
+            // own bit (the mask is EXEC under a scalar condition)
+            if check
+                && let Some(last) = block.insts.last()
+                && last.name().starts_with("s_cbranch_scc")
+                && let Some(scc) = last.read(Reg::Scc)
+                && wild(of(kind, Some(scc)))
+            {
+                let own = matches!(st.exits[b], LaneExit::Branch { when, .. }
+                    if !st.bools.support(when).iter().any(|a| matches!(a, Atom::Uniform(v) if *v == scc)));
+                if !own {
+                    return Err((last.machine.offset, TOTAL));
+                }
+            }
+        }
+        Ok(())
+    };
+    let mut kind: HashMap<Value, Wave> = HashMap::new();
+    let mut firsts: HashSet<Value> = HashSet::new();
+    // to a fixpoint (values carried around loops), then once more to say what is wrong
+    let mut settled = false;
+    for _ in 0..16 {
+        let before = (kind.clone(), firsts.len());
+        pass(&mut kind, &mut firsts, false)?;
+        if (&before.0, before.1) == (&kind, firsts.len()) {
+            settled = true;
+            break;
+        }
+    }
+    if !settled {
+        return Err((0, MIXED));
+    }
+    pass(&mut kind, &mut firsts, true)
+}
diff --git a/crates/victory-shader/src/emit/link.rs b/crates/victory-shader/src/emit/link.rs
new file mode 100644
index 000000000..bb82c1e6a
--- /dev/null
+++ b/crates/victory-shader/src/emit/link.rs
@@ -0,0 +1,244 @@
+//! A mesh program and the pixel program drawn with it, translated for one host pipeline
+//! ([`link_mesh`]).
+//!
+//! D3D12 caps a mesh shader's outputs at 32 KiB: 4 bytes per component of every vertex
+//! element times the declared vertex maximum rounded up to 32, plus the same for primitive
+//! elements (`container::mesh_output_bytes`, as the validator measures it). 71 of the
+//! title's mesh programs pass it as the console declares their outputs: pedestrian,
+//! vehicle and prop transforms with fire, spatter, decal and transmission variants, 128
+//! vertices of 65 to 71 components (33,280 to 36,352 bytes). NVIDIA's driver builds their
+//! pipelines anyway, but the programs are invalid. D3D12 links the two stages by semantic,
+//! and a pipeline needs only the outputs its pixel program reads: of the title's pixel
+//! programs whose inputs such a mesh program writes, the one that reads most reads 55
+//! components (a pedestrian fire prepass). So the pair is translated again for its
+//! pipeline: the mesh program declares and writes only the outputs the pixel program reads
+//! (and its system values), and the pixel program leaves out the inputs it never reads,
+//! which D3D12 would otherwise refuse as inputs the mesh program does not write. The
+//! elements kept keep their rows and columns, each program its code and bindings. Measured
+//! offline (`victory translate` with `VICTORY_PAIRS`): the ten pixel programs that read most
+//! for each of the 71, and the three pairs drawn in the runs so far, all link, validate and
+//! get a pipeline on an RTX 5090. A pipeline without a pixel program (the title draws depth
+//! with mesh programs alone) gets the mesh program with its system values only
+//! ([`link_mesh_alone`]), which is also what the offline census validates for the 71.
+
+use super::container::{MESH_OUTPUT_LIMIT, SigElement, mesh_output_bytes};
+use super::{HostShader, translate};
+use crate::dxbc::{Container, FourCC, u32_at};
+use crate::native::HwStage;
+use crate::ShaderError;
+
+thread_local! {
+    /// See [`with_linked`].
+    static LINKED: std::cell::RefCell<Option<Linked>> = const { std::cell::RefCell::new(None) };
+}
+
+/// What a stage leaves out of its signatures for its partner in one host pipeline
+/// ([`link_mesh`]): elements of arbitrary semantics, by name and index.
+#[derive(Debug, Clone, Default, PartialEq, Eq)]
+pub(super) struct Linked {
+    pub inputs: Vec<(String, u32)>,
+    pub outputs: Vec<(String, u32)>,
+}
+
+/// Runs `f` with programs lowered for a linked pipeline: the elements `linked` names leave
+/// the signatures; stores to such an output are not made, and the other elements keep their
+/// rows and modes (ids count only what is kept). An input left out must be one the program
+/// never reads: a lowering that reads one fails.
+pub(super) fn with_linked<R>(linked: Linked, f: impl FnOnce() -> R) -> R {
+    let was = LINKED.replace(Some(linked));
+    let r = f();
+    LINKED.set(was);
+    r
+}
+
+/// Per element of `inputs` and of `outputs` (the signatures as the console declares them),
+/// whether the stage being lowered leaves it out ([`with_linked`]); empty when not linking.
+pub(super) fn left_out(inputs: &[SigElement], outputs: &[SigElement]) -> (Vec<bool>, Vec<bool>) {
+    LINKED.with_borrow(|l| match l {
+        Some(l) => {
+            let of = |els: &[SigElement], names: &[(String, u32)]| {
+                els.iter()
+                    .map(|e| e.kind == 0 && names.iter().any(|(n, i)| n.eq_ignore_ascii_case(&e.name) && *i == e.index))
+                    .collect::<Vec<bool>>()
+            };
+            (of(inputs, &l.inputs), of(outputs, &l.outputs))
+        }
+        None => (Vec::new(), Vec::new()),
+    })
+}
+
+/// The translations of the mesh program `ms` (container `ms_container`) and the pixel program
+/// `ps` (container `ps_container`) for one host pipeline, when `ms`'s outputs pass D3D12's 32
+/// KiB as translated alone: the mesh program without the outputs the pixel program does not
+/// read, the pixel program without the inputs it does not read (see the module notes).
+///
+/// `None` (make the pipeline of `ms` and `ps` as they are) when `ms` fits, when the pixel
+/// program reads every output `ms` has, when the linked mesh program still does not fit, or
+/// when a linked translation binds anything differently from its shared one (the pipeline's
+/// root signature is made from the shared ones).
+pub fn link_mesh(
+    ms_container: &[u8],
+    ms: &HostShader,
+    ps_container: &[u8],
+    ps: &HostShader,
+) -> Result<Option<(HostShader, HostShader)>, ShaderError> {
+    if ms.stage != HwStage::Ms || ps.stage != HwStage::Ps || mesh_fits(&ms.dxil)? {
+        return Ok(None);
+    }
+    let inputs = elements(&ps.dxil, FourCC::ISG1)?;
+    let read = |e: &Element| {
+        inputs
+            .iter()
+            .any(|i| i.arbitrary() && i.used != 0 && i.name.eq_ignore_ascii_case(&e.name) && i.index == e.index)
+    };
+    let Some(linked_ms) = mesh_without(ms_container, ms, read)? else {
+        return Ok(None);
+    };
+    let unread: Vec<(String, u32)> = inputs.iter().filter(|i| i.arbitrary() && i.used == 0).map(named).collect();
+    let linked_ps = if unread.is_empty() {
+        ps.clone()
+    } else {
+        with_linked(
+            Linked {
+                inputs: unread,
+                outputs: Vec::new(),
+            },
+            || translate(ps_container),
+        )?
+    };
+    if !same(ps, &linked_ps) {
+        return Ok(None);
+    }
+    Ok(Some((linked_ms, linked_ps)))
+}
+
+/// The translation of the mesh program `ms` (container `ms_container`) for a pipeline without a
+/// pixel program, when its outputs pass D3D12's 32 KiB as translated alone: its system values
+/// (position, clip and cull distances) and none of its other outputs, which only a pixel
+/// program would read. The title draws depth with mesh programs alone (143 of them in the runs
+/// so far); this keeps such a pipeline of one of the 71 valid too.
+///
+/// `None` (make the pipeline of `ms` as it is) as for [`link_mesh`]: when `ms` fits, has no
+/// output to leave out, still does not fit, or binds anything differently linked.
+pub fn link_mesh_alone(ms_container: &[u8], ms: &HostShader) -> Result<Option<HostShader>, ShaderError> {
+    if ms.stage != HwStage::Ms || mesh_fits(&ms.dxil)? {
+        return Ok(None);
+    }
+    mesh_without(ms_container, ms, |_| false)
+}
+
+/// `ms` translated again without its outputs of arbitrary semantics that `read` does not
+/// keep; `None` when it leaves none out, or the result does not fit or binds differently.
+fn mesh_without(
+    ms_container: &[u8],
+    ms: &HostShader,
+    read: impl Fn(&Element) -> bool,
+) -> Result<Option<HostShader>, ShaderError> {
+    let outputs: Vec<(String, u32)> = elements(&ms.dxil, FourCC::OSG1)?
+        .iter()
+        .filter(|e| e.arbitrary() && !read(e))
+        .map(named)
+        .collect();
+    if outputs.is_empty() {
+        return Ok(None);
+    }
+    let linked = with_linked(
+        Linked {
+            inputs: Vec::new(),
+            outputs,
+        },
+        || translate(ms_container),
+    )?;
+    if !mesh_fits(&linked.dxil)? || !same(ms, &linked) {
+        return Ok(None);
+    }
+    Ok(Some(linked))
+}
+
+fn named(e: &Element) -> (String, u32) {
+    (e.name.clone(), e.index)
+}
+
+/// Whether two translations of one program bind the same (all but their code).
+fn same(a: &HostShader, b: &HostShader) -> bool {
+    HostShader { dxil: Vec::new(), ..a.clone() } == HostShader { dxil: Vec::new(), ..b.clone() }
+}
+
+/// Whether an emitted mesh program's outputs fit D3D12's 32 KiB (a program of another stage
+/// fits).
+pub fn mesh_fits(dxil: &[u8]) -> Result<bool, ShaderError> {
+    let c = Container::parse(dxil)?;
+    let Some(psv) = c.part(FourCC::PSV0) else {
+        return Ok(true);
+    };
+    // runtime info (its size first): shader kind at byte 24, mesh maxima at bytes 12 and 14
+    let info = psv.data.get(4..).ok_or(ShaderError::Malformed("truncated"))?;
+    if info.get(24) != Some(&13) {
+        return Ok(true);
+    }
+    let half = |at: usize| info.get(at..at + 2).map_or(0, |b| u32::from(u16::from_le_bytes([b[0], b[1]])));
+    let declared = |fourcc| -> Result<Vec<SigElement>, ShaderError> {
+        Ok(elements(dxil, fourcc)?
+            .into_iter()
+            .map(|e| SigElement {
+                name: e.name,
+                index: e.index,
+                kind: 0,
+                comp: 0,
+                interp: 0,
+                row: None,
+                col: 0,
+                cols: e.mask.count_ones() as u8,
+                usage: 0,
+                half: false,
+            })
+            .collect())
+    };
+    let bytes = mesh_output_bytes(&declared(FourCC::OSG1)?, &declared(FourCC::PSG1)?, half(12), half(14));
+    Ok(bytes <= MESH_OUTPUT_LIMIT)
+}
+
+/// A row of an emitted signature part (`container::signature`).
+struct Element {
+    name: String,
+    index: u32,
+    /// The system value (0: an arbitrary semantic).
+    sv: u32,
+    mask: u8,
+    /// Inputs: the components read.
+    used: u8,
+}
+
+impl Element {
+    fn arbitrary(&self) -> bool {
+        self.sv == 0
+    }
+}
+
+fn elements(dxil: &[u8], fourcc: FourCC) -> Result<Vec<Element>, ShaderError> {
+    let c = Container::parse(dxil)?;
+    let Some(part) = c.part(fourcc) else {
+        return Ok(Vec::new());
+    };
+    let part = part.data;
+    let count = u32_at(part, 0)? as usize;
+    let base = u32_at(part, 4)? as usize;
+    (0..count)
+        .map(|i| {
+            let at = base + 32 * i;
+            let name_at = u32_at(part, at + 4)? as usize;
+            let name = part
+                .get(name_at..)
+                .and_then(|s| s.split(|&b| b == 0).next())
+                .ok_or(ShaderError::Malformed("signature name out of bounds"))?;
+            let bytes = part.get(at + 24..at + 26).ok_or(ShaderError::Malformed("truncated"))?;
+            Ok(Element {
+                name: String::from_utf8_lossy(name).into_owned(),
+                index: u32_at(part, at + 8)?,
+                sv: u32_at(part, at + 12)?,
+                mask: bytes[0],
+                used: bytes[1],
+            })
+        })
+        .collect()
+}
diff --git a/crates/victory-shader/src/emit/loop_tests.rs b/crates/victory-shader/src/emit/loop_tests.rs
