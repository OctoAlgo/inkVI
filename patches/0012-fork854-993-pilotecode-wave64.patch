+fn parse_loop_limits(value: Option<&str>) -> LoopLimits {
+    let number = |v: &str| {
+        let v = v.trim();
+        match v.strip_prefix("0x") {
+            Some(hex) => u32::from_str_radix(hex, 16).ok(),
+            None => v.parse().ok(),
+        }
+        .filter(|&n| n > 0)
