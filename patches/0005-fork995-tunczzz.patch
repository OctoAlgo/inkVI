+                    }
+                    let (from, offset) = match how {
+                        How::Straight => (self.args.clone(), at),
+                        How::Alone => {
+                            assert!(record_clamp(&self.clamp, &l, &self.alone_scratch, budget, (&self.args, at), None, (kind, stride, 1)));
+                            self.bind(draws);
+                            (self.alone_scratch.clone(), 0)
