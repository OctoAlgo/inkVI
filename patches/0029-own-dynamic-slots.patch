From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Octo <180629317+OctoAlgo@users.noreply.github.com>
Date: Thu, 26 Nov 2026 07:58:54 +0100
Subject: [PATCH 29/38] VICTORY_DYNAMIC_SLOTS=<n>: a larger ring of dynamic
 view slots on a capped host heap (off by default)

Idea from trustno1-coder/VIctory-NVIDIA a9632bc (GPL-3.0, read and audited; this is our own
code): NVIDIA caps the view heap at 1,000,000 for the title's 1,245,184, and the 2^18 dynamic
slots can run full (fork main run 300: refused tables = dropped draws). With the switch the ring
gets n slots (2^18..half the heap) taken from the title's slots kept in place; the allocator's
bitmap, free count and wrap now follow the heap's own count instead of the constant.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

Kit-Source: own (opt-in; see docs/known-issues.md)
Kit-Licence: GPL-3.0
---
 crates/victory-gpu/src/descriptor/host.rs | 32 ++++++++++++++++++++---
 1 file changed, 29 insertions(+), 3 deletions(-)

diff --git a/crates/victory-gpu/src/descriptor/host.rs b/crates/victory-gpu/src/descriptor/host.rs
index 3d3c685c2..bff32deae 100644
--- a/crates/victory-gpu/src/descriptor/host.rs
+++ b/crates/victory-gpu/src/descriptor/host.rs
@@ -1167,6 +1167,20 @@ pub(crate) fn probe_view_limit() {
 /// table past them is made afresh in these slots like any other.
 pub(crate) const DYNAMIC: u32 = 1 << 18;
 
+/// The dynamic slots of a capped view heap whose null slot is `null`
+/// (`VICTORY_DYNAMIC_SLOTS`, read once; [`DYNAMIC`] when unset).
+fn dynamic_slots_capped(null: u32) -> u32 {
+    static SLOTS: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *SLOTS.get_or_init(|| {
+        let asked = std::env::var("VICTORY_DYNAMIC_SLOTS").ok().and_then(|v| v.trim().parse::<u32>().ok());
+        let slots = asked.map_or(DYNAMIC, |n| n.clamp(DYNAMIC, (null / 2).max(DYNAMIC)));
+        if slots != DYNAMIC {
+            tracing::info!(slots, title_slots_in_place = null - slots, "dynamic view slots on a capped host heap (VICTORY_DYNAMIC_SLOTS)");
+        }
+        slots
+    })
+}
+
 impl HostHeap {
     pub(crate) fn new(sampler: bool, count: u32) -> Option<Self> {
         let host = host()?;
@@ -1199,6 +1213,18 @@ impl HostHeap {
         } else {
             victory_shader::emit::view_heap_limit()
         };
+        // LOCAL (round 8, after trustno1-coder/VIctory-NVIDIA a9632bc's finding;
+        // our own code): on a host that caps view heaps (NVIDIA: 1,000,000 for
+        // the title's 1,245,184) the title's slots past the cap are not kept in
+        // place anyway, and the ring of dynamic slots (2^18) can run full: a
+        // table that finds no room is a dropped draw. `VICTORY_DYNAMIC_SLOTS=<n>`
+        // gives the ring n slots there (at least 2^18, at most half the heap),
+        // taken from the title's slots kept in place. Unset: as before.
+        let extra = if !sampler && null != 0 && count + extra > null {
+            dynamic_slots_capped(null)
+        } else {
+            extra
+        };
         let (heap, count, size) = if null == 0 {
             match make(count + extra) {
                 Ok(heap) => (heap, count, count + extra),
@@ -1278,8 +1304,8 @@ impl HostHeap {
                 .map(|_| std::sync::atomic::AtomicU64::new(0))
                 .collect(),
             kept: (0..count + extra).map(|_| Mutex::new(None)).collect(),
-            next: Mutex::new((0, vec![false; DYNAMIC as usize])),
-            free: std::sync::atomic::AtomicU32::new(DYNAMIC),
+            next: Mutex::new((0, vec![false; if sampler { DYNAMIC } else { extra } as usize])),
+            free: std::sync::atomic::AtomicU32::new(if sampler { DYNAMIC } else { extra }),
             too_long: std::sync::atomic::AtomicU32::new(u32::MAX),
             strides,
             buffers: Mutex::default(),
@@ -1448,7 +1474,7 @@ impl HostHeap {
         crate::copystat::add(crate::copystat::C::DynamicNs, started.elapsed().as_nanos() as u64);
         taken[first..first + n].fill(true);
         self.free.fetch_sub(n as u32, std::sync::atomic::Ordering::Relaxed);
-        *next = ((first + n) % DYNAMIC as usize) as u32;
+        *next = ((first + n) % self.dynamic.max(1) as usize) as u32;
         Some(self.count + first as u32)
     }
 
