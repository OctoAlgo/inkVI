+    // SAFETY: the job table holds `RUN_JOBS` jobs and `r.n` is below that
+    // (a run that has them all takes no more); the list is not submitted
+    // while it is recorded.
+    unsafe { write_job(r.jobs as *mut u8, r.n, job) };
+    r.n += 1;
