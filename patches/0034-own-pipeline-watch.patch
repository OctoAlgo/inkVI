index 8806c2f14..768184855 100644
--- a/crates/victory-gpu/src/pipeline/library.rs
+++ b/crates/victory-gpu/src/pipeline/library.rs
@@ -270,6 +270,21 @@ fn call(what: &'static str, name: &str) -> Call {
     Call(thread, since)
 }
 
+/// The library calls running now, for the workers' watch line: thread,
+/// what, for how long, the pipeline (shortened).
+pub(crate) fn calls_now() -> String {
+    let now = crate::host::now_us();
+    let calls = CALLS.lock().unwrap_or_else(|e| e.into_inner());
+    calls
+        .iter()
+        .map(|(t, what, name, since)| {
+            let short: String = name.chars().take(60).collect();
+            format!("[{t} {what} {}ms {short}]", now.saturating_sub(*since) / 1000)
+        })
+        .collect::<Vec<_>>()
+        .join(" ")
+}
+
 impl Drop for Call {
     fn drop(&mut self) {
         CALLS
