+        Repeat(u64, u64),
     }
 
     impl When {
@@ -1235,7 +1238,10 @@ mod host {
                     None => rest.parse().ok().map(|a: u64| (a, a + HOLD.max(1) - 1)),
                 }
             };
-            if let Some(rest) = at.strip_prefix('w') {
+            if let Some(rest) = at.strip_prefix('r') {
+                let (a, b) = rest.split_once('/')?;
+                Some(When::Repeat(a.parse().ok()?, b.parse::<u64>().ok()?.max(4)))
+            } else if let Some(rest) = at.strip_prefix('w') {
                 frames(rest).map(|(a, b)| When::World(a, b))
             } else if let Some(rest) = at.strip_prefix('f') {
                 frames(rest).map(|(a, b)| When::Present(a, b))
@@ -1256,6 +1262,9 @@ mod host {
     /// of game time in every run) or `f<N>[-<M>]` (presents since the
     /// start); the key is held from frame N through M (N plus
     /// `VICTORY_KEYS_HOLD_FRAMES` - 1 unless given; 2 frames by default).
+    /// `r<start>/<every>:<key>`: pressed every <every> presents from present
+    /// <start> on, until world frame 0 (the start screen's Enter as soon as
+    /// it listens, nothing once the world runs).
     fn scripted() -> Vec<u8> {
         static SCRIPT: LazyLock<(Instant, Vec<(When, u8)>)> = LazyLock::new(|| {
             let list = std::env::var("VICTORY_KEYS").unwrap_or_default();
@@ -1298,6 +1307,7 @@ mod host {
                 When::Time(at) => (at..at + *HOLD).contains(&now),
                 When::World(a, b) => world.is_some_and(|w| (a..=b).contains(&w)),
                 When::Present(a, b) => (a..=b).contains(&presents),
+                When::Repeat(a, every) => world.is_none() && presents >= a && (presents - a) % every < 2,
             })
             .map(|&(_, vk)| vk)
             .collect();
