From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Octo <180629317+OctoAlgo@users.noreply.github.com>
Date: Wed, 25 Nov 2026 19:56:50 +0100
Subject: [PATCH 19/38] the clamp's split-dispatch line reads rec_records (the
 #993 merge left #993's name: the clamp did not compile, every indirect call
 was dropped)

Kit-Source: own (fix of the #993 merge: the clamp did not compile)
Kit-Licence: GPL-3.0
---
 crates/victory-gpu/src/indirect.rs | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/crates/victory-gpu/src/indirect.rs b/crates/victory-gpu/src/indirect.rs
index 6725091e4..c82aefe36 100644
--- a/crates/victory-gpu/src/indirect.rs
+++ b/crates/victory-gpu/src/indirect.rs
@@ -338,7 +338,7 @@ void main(uint3 id : SV_DispatchThreadID, uint gi : SV_GroupIndex) {
     if (!active) {
         // The host runs every record of a split dispatch (the count is the
         // clamp's alone): those past the count run empty.
-        if (kind == 3u && id.x < records) {
+        if (kind == 3u && id.x < rec_records) {
             for (uint k = 0; k < SPLIT; k++) {
                 dst_args.Store4(id.x * SPLIT * 16u + k * 16u, uint4(k * 65535u, 0u, 0u, 0u));
             }
