+                    root: &root,
+                    constants: objects[0].0.clone(),
+                    draw_dword: None,
+                    root_srvs: objects[0].1.clone(),
+                    objects: objects.clone(),
+                    groups,
+                    draws: 400,
+                    alternate: false,
+                    stamp_each: true,
+                    between: if barrier_each {
