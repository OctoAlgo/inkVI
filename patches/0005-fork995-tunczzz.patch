+/// `run_cost`), so it is clamped alone then.
+pub(crate) fn batched(
+    list: &HostList,
+    run: &mut Option<Run>,
+    (src, src_offset): (&ID3D12Resource, u64),
+    count: Option<(&ID3D12Resource, u64)>,
+    (kind, stride, records): (u32, u32, u32),
+    last: bool,
