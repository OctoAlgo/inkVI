+                        objects: Vec::new(),
+                        groups,
+                        draws,
+                        alternate: false,
+                        stamp_each,
+                        between,
+                        read: None,
+                        launch: Launch::Direct,
+                        amplify_params: None,
+                    };
+                    let us = b.time(&run);
+                    let tag = match (stamp_each, barrier_each) {
+                        (false, _) => "",
+                        (true, false) => "stamp",
+                        (true, true) => "drain",
+                    };
+                    line.push_str(&format!(" g{groups}{tag}={us:.2}"));
+                }
+            }
+            println!("{line}");
+        }
+    }
