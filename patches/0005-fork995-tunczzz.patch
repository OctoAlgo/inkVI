+/// The parts of `[from, to)` that lie in `ranges` (in order, joined), in
+/// order.
+fn parts_in(ranges: &[(usize, usize)], from: usize, to: usize) -> Vec<(usize, usize)> {
+    if from >= to {
+        return Vec::new();
+    }
+    let at = ranges.partition_point(|r| r.1 <= from);
+    ranges[at..]
+        .iter()
+        .take_while(|r| r.0 < to)
+        .map(|r| (r.0.max(from), r.1.min(to)))
+        .filter(|r| r.0 < r.1)
+        .collect()
+}
