+    /// LOCAL (tools-iter): when a scripted key is held.
+    #[derive(Clone, Copy)]
+    enum When {
+        /// From this long after input starts, for `VICTORY_KEYS_HOLD`.
+        Time(Duration),
+        /// World frames, first and last.
+        World(u64, u64),
+        /// Presents, first and last.
+        Present(u64, u64),
+    }
+
+    impl When {
+        fn parse(at: &str) -> Option<When> {
+            let frames = |rest: &str| -> Option<(u64, u64)> {
+                static HOLD: LazyLock<u64> = LazyLock::new(|| {
+                    std::env::var("VICTORY_KEYS_HOLD_FRAMES").ok().and_then(|v| v.trim().parse().ok()).unwrap_or(2)
+                });
+                match rest.split_once('-') {
+                    Some((a, b)) => Some((a.parse().ok()?, b.parse().ok()?)),
+                    None => rest.parse().ok().map(|a: u64| (a, a + HOLD.max(1) - 1)),
+                }
+            };
+            if let Some(rest) = at.strip_prefix('w') {
+                frames(rest).map(|(a, b)| When::World(a, b))
+            } else if let Some(rest) = at.strip_prefix('f') {
+                frames(rest).map(|(a, b)| When::Present(a, b))
+            } else {
+                Duration::try_from_secs_f64(at.parse().ok()?).ok().map(When::Time)
+            }
+        }
+    }
+
